<%- include('partials/header') %>

<style>
/* ========== RESET & BASE ========== */
.products-page { background: #f5f5f5; min-height: 100vh; }
.products-page .container-main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}

/* ========== HERO BANNER SLIDER ========== */
.products-hero {
  width: 100%;
  position: relative;
  overflow: hidden;
  background: #1a1a2e;
  margin-bottom: 16px;
}
.products-hero-inner {
  display: flex;
  transition: transform 0.5s ease;
}
.products-hero-slide {
  min-width: 100%;
  height: 320px;
  background-size: cover;
  background-position: center;
  position: relative;
  display: flex;
  align-items: center;
}
.products-hero-slide-1 { background-image: url('/picture/16.jpg'); }
.products-hero-slide-2 { background-image: url('/picture/17.jpg'); }
.products-hero-slide-3 { background-image: url('/picture/18.jpg'); }
.hero-slide-content {
  position: absolute;
  left: 60px;
  color: #fff;
  z-index: 2;
}
.hero-slide-content h2 {
  font-size: 2rem; font-weight: 800;
  text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  line-height: 1.2;
}
.hero-slide-content p {
  font-size: 1.1rem;
  text-shadow: 0 1px 4px rgba(0,0,0,0.5);
}
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(90deg, rgba(0,0,0,0.5) 0%, transparent 60%);
}
.hero-dots-wrap {
  position: absolute; bottom: 12px; left: 50%;
  transform: translateX(-50%);
  display: flex; gap: 6px; z-index: 3;
}
.hero-dot-item {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  cursor: pointer; border: none;
  transition: background 0.2s, width 0.2s;
  padding: 0;
}
.hero-dot-item.active {
  background: #fff;
  width: 24px; border-radius: 4px;
}
.hero-arrow-btn {
  position: absolute; top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  background: rgba(255,255,255,0.2);
  border: none; color: #fff;
  width: 36px; height: 36px;
  border-radius: 50%;
  font-size: 1.2rem;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s;
}
.hero-arrow-btn:hover { background: rgba(255,255,255,0.4); }
.hero-arrow-btn.prev { left: 12px; }
.hero-arrow-btn.next { right: 12px; }

/* ========== SEARCH BAR ========== */
.products-searchbar {
  background: #fff;
  padding: 14px 0;
  margin-bottom: 12px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}
.searchbar-inner {
  display: flex;
  gap: 10px;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
  flex-wrap: wrap;
}
.search-input-wrap {
  flex: 1; min-width: 200px;
  display: flex;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  overflow: hidden;
}
.search-input-wrap input {
  flex: 1; border: none; outline: none;
  padding: 9px 14px;
  font-size: 0.88rem;
}
.search-input-wrap button {
  background: #1a1a2e;
  color: #fff; border: none;
  padding: 0 18px;
  font-size: 0.85rem;
  cursor: pointer;
  white-space: nowrap;
}
.search-select {
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  padding: 9px 12px;
  font-size: 0.85rem;
  outline: none;
  background: #fff;
  color: #333;
}
.search-apply-btn {
  background: #1a1a2e;
  color: #fff; border: none;
  padding: 9px 20px;
  border-radius: 4px;
  font-size: 0.85rem;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.2s;
}
.search-apply-btn:hover { background: #2d3e5e; }

/* ========== XU HƯỚNG TÌM KIẾM ========== */
.trending-section {
  background: #fff;
  padding: 14px 0;
  margin-bottom: 12px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}
.trending-inner {
  max-width: 1200px; margin: 0 auto; padding: 0 16px;
}
.trending-title {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #333;
  margin-bottom: 12px;
  padding-bottom: 6px;
  border-bottom: 2px solid #1a1a2e;
  display: inline-block;
}
.trending-scroll-wrap { position: relative; }
.trending-scroll {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding-bottom: 4px;
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.trending-scroll::-webkit-scrollbar { display: none; }
.trending-item {
  display: flex; flex-direction: column;
  align-items: center; gap: 6px;
  flex-shrink: 0;
  text-decoration: none; color: #333;
  width: 90px;
  transition: color 0.2s;
}
.trending-item:hover { color: #1a1a2e; }
.trending-img-wrap {
  width: 72px; height: 72px;
  border-radius: 50%;
  border: 2px solid #e8e8e8;
  overflow: hidden;
  background: #f5f5f5;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.8rem;
  transition: border-color 0.2s;
}
.trending-item:hover .trending-img-wrap { border-color: #1a1a2e; }
.trending-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
.trending-label {
  font-size: 0.72rem;
  text-align: center;
  line-height: 1.3;
}
.trend-arrow {
  position: absolute; top: 50%; transform: translateY(-50%);
  background: #fff;
  border: 1px solid #e0e0e0;
  border-radius: 50%;
  width: 28px; height: 28px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; font-size: 0.8rem;
  z-index: 2;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  transition: background 0.15s;
}
.trend-arrow:hover { background: #f5f5f5; }
.trend-arrow.left { left: -14px; }
.trend-arrow.right { right: -14px; }

/* ========== BANNER 3 CỘT ========== */
.banner3-section {
  margin-bottom: 12px;
}
.banner3-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8px;
}
.banner3-item {
  border-radius: 4px;
  overflow: hidden;
  position: relative;
  aspect-ratio: 16/7;
  background: #ddd;
  display: block;
  text-decoration: none;
}
.banner3-item img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.3s;
}
.banner3-item:hover img { transform: scale(1.04); }

/* ========== SECTION SẢN PHẨM THEO DANH MỤC ========== */
.cat-section {
  background: #fff;
  border-radius: 4px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  margin-bottom: 16px;
  overflow: hidden;
}
.cat-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px 10px;
  border-bottom: 1px solid #f0f0f0;
}
.cat-section-title {
  font-size: 1rem;
  font-weight: 700;
  color: #1a1a2e;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  position: relative;
  padding-left: 12px;
}
.cat-section-title::before {
  content: '';
  position: absolute; left: 0; top: 50%;
  transform: translateY(-50%);
  width: 4px; height: 18px;
  background: #1a1a2e;
  border-radius: 2px;
}
.cat-see-all {
  font-size: 0.8rem; color: #666;
  text-decoration: none;
  transition: color 0.2s;
}
.cat-see-all:hover { color: #1a1a2e; }

/* Layout: ảnh dọc trái + lưới sản phẩm phải */
.cat-body {
  display: grid;
  grid-template-columns: 220px 1fr;
}
.cat-banner-vert {
  position: relative;
  overflow: hidden;
  border-right: 1px solid #f0f0f0;
}
.cat-banner-vert img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.cat-banner-vert-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 50%);
  display: flex; flex-direction: column;
  justify-content: flex-end;
  padding: 16px;
}
.cat-banner-vert-overlay h3 {
  color: #fff; font-size: 1rem;
  font-weight: 700; margin: 0 0 4px;
  line-height: 1.3;
}
.cat-banner-vert-overlay p {
  color: rgba(255,255,255,0.8);
  font-size: 0.75rem; margin: 0 0 10px;
}
.cat-banner-vert-overlay a {
  display: inline-block;
  background: #fff; color: #1a1a2e;
  padding: 5px 14px;
  border-radius: 2px;
  font-size: 0.78rem; font-weight: 600;
  text-decoration: none;
  transition: background 0.2s;
}
.cat-banner-vert-overlay a:hover { background: #f0f0f0; }

/* Lưới sản phẩm bên phải */
.cat-products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}
.cat-product-card {
  border-right: 1px solid #f0f0f0;
  border-bottom: 1px solid #f0f0f0;
  padding: 12px;
  transition: box-shadow 0.2s;
  position: relative;
  background: #fff;
}
.cat-product-card:hover {
  z-index: 1;
  box-shadow: 0 4px 16px rgba(0,0,0,0.12);
}
.cat-product-img {
  width: 100%;
  aspect-ratio: 1/1;
  object-fit: cover;
  border-radius: 2px;
  display: block;
  transition: transform 0.3s;
}
.cat-product-card:hover .cat-product-img { transform: scale(1.04); }
.cat-product-img-wrap {
  overflow: hidden;
  border-radius: 2px;
  margin-bottom: 8px;
  position: relative;
}
.cat-discount-badge {
  position: absolute; top: 6px; left: 6px;
  background: #e53935; color: #fff;
  font-size: 0.65rem; font-weight: 700;
  padding: 2px 6px; border-radius: 2px;
  z-index: 1;
}
.cat-product-name {
  font-size: 0.8rem;
  color: #333;
  line-height: 1.4;
  margin-bottom: 4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 2.2rem;
  text-decoration: none;
}
.cat-product-name:hover { color: #1a1a2e; }
.cat-product-price {
  color: #e53935;
  font-size: 0.88rem;
  font-weight: 600;
}
.cat-product-old-price {
  color: #999;
  font-size: 0.75rem;
  text-decoration: line-through;
  margin-left: 4px;
}
.cat-more-btn {
  display: block;
  text-align: center;
  padding: 10px;
  border-top: 1px solid #f0f0f0;
  color: #555;
  text-decoration: none;
  font-size: 0.82rem;
  transition: background 0.15s, color 0.2s;
}
.cat-more-btn:hover { background: #fafafa; color: #1a1a2e; }

/* ========== EMPTY STATE ========== */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  background: #fff;
  border-radius: 4px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}

/* ========== RESPONSIVE ========== */
@media (max-width: 991px) {
  .cat-body { grid-template-columns: 160px 1fr; }
  .cat-products-grid { grid-template-columns: repeat(3, 1fr); }
  .banner3-grid { grid-template-columns: 1fr 1fr; }
  .banner3-item:last-child { display: none; }
}
@media (max-width: 767px) {
  .products-hero-slide { height: 200px; }
  .hero-slide-content { left: 24px; }
  .hero-slide-content h2 { font-size: 1.2rem; }
  .cat-body { grid-template-columns: 1fr; }
  .cat-banner-vert { height: 140px; }
  .cat-products-grid { grid-template-columns: repeat(2, 1fr); }
  .banner3-grid { grid-template-columns: 1fr; }
  .searchbar-inner { gap: 8px; }
}
</style>

<div class="products-page">

  <!-- ===== HERO BANNER SLIDER ===== -->
  <div class="products-hero">
    <div class="products-hero-inner" id="prodHeroInner">
      <div class="products-hero-slide products-hero-slide-1">
        <div class="hero-overlay"></div>
        <div class="hero-slide-content">
          <p style="color:#a8d8b0; font-size:0.85rem; font-weight:600; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">Mới về</p>
          <h2>Cá cảnh đẹp<br>Freeship từ 200k</h2>
          <a href="/products?category=fish" style="display:inline-block; margin-top:14px; background:#fff; color:#1a1a2e; padding:8px 20px; border-radius:2px; font-weight:600; font-size:0.85rem; text-decoration:none;">Xem ngay →</a>
        </div>
      </div>
      <div class="products-hero-slide products-hero-slide-2">
        <div class="hero-overlay"></div>
        <div class="hero-slide-content">
          <p style="color:#ffd580; font-size:0.85rem; font-weight:600; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">HOT</p>
          <h2>Hamster dễ thương<br>Giảm đến 30%</h2>
          <a href="/products?category=hamster" style="display:inline-block; margin-top:14px; background:#fff; color:#1a1a2e; padding:8px 20px; border-radius:2px; font-weight:600; font-size:0.85rem; text-decoration:none;">Mua ngay →</a>
        </div>
      </div>

      <div class="products-hero-slide products-hero-slide-3">
        <div class="hero-overlay"></div>
        <div class="hero-slide-content">
          <p style="color:#ffb3a0; font-size:0.85rem; font-weight:600; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px;">ĐỘC LẠ</p>
          <h2>Bò sát cảnh<br>Hàng nhập khẩu</h2>
          <a href="/products?category=reptile" style="display:inline-block; margin-top:14px; background:#fff; color:#1a1a2e; padding:8px 20px; border-radius:2px; font-weight:600; font-size:0.85rem; text-decoration:none;">Khám phá →</a>
        </div>
      </div>
    </div>
    <button class="hero-arrow-btn prev" type="button" onclick="prodHeroSlide(-1)">&#8249;</button>
    <button class="hero-arrow-btn next" type="button" onclick="prodHeroSlide(1)">&#8250;</button>
    <div class="hero-dots-wrap">
      <button class="hero-dot-item active" onclick="prodHeroGoTo(0)"></button>
      <button class="hero-dot-item" onclick="prodHeroGoTo(1)"></button>
      <button class="hero-dot-item" onclick="prodHeroGoTo(2)"></button>
    </div>
  </div>

  <!-- ===== SEARCH BAR ===== -->
  <div class="products-searchbar">
    <form method="GET" action="/products">
      <div class="searchbar-inner">
        <div class="search-input-wrap">
          <input type="text" name="search" value="<%= search %>" placeholder="Tìm sản phẩm, phụ kiện...">
          <button type="submit"><i class="bi bi-search me-1"></i>Tìm</button>
        </div>
        <select name="category" class="search-select">
          <option value="">Tất cả danh mục</option>
          <option value="fish"      <%= category==='fish'      ?'selected':'' %>>🐠 Cá cảnh</option>
          <option value="tank"      <%= category==='tank'      ?'selected':'' %>>🏘️ Bể & Lồng</option>
          <option value="hamster"   <%= category==='hamster'   ?'selected':'' %>>🐹 Hamster</option>
          <option value="reptile"   <%= category==='reptile'   ?'selected':'' %>>🦎 Bò sát</option>
          <option value="food"      <%= category==='food'      ?'selected':'' %>>🌿 Thức ăn</option>
          <option value="medicine"  <%= category==='medicine'  ?'selected':'' %>>💊 Thuốc</option>
          <option value="accessory" <%= category==='accessory' ?'selected':'' %>>🎯 Phụ kiện</option>
          <option value="clothing"  <%= category==='clothing'  ?'selected':'' %>>👗 Quần áo</option>
        </select>
        <select name="sort" class="search-select">
          <option value="">Mặc định</option>
          <option value="price-asc"  <%= sort==='price-asc'  ?'selected':'' %>>Giá thấp → cao</option>
          <option value="price-desc" <%= sort==='price-desc' ?'selected':'' %>>Giá cao → thấp</option>
        </select>
        <button type="submit" class="search-apply-btn">Áp dụng</button>
      </div>
    </form>
  </div>

  <div class="container-main">
    <!-- ===== BANNER 3 CỘT ===== -->
    <div class="banner3-section">
      <div class="banner3-grid">
        <a href="/products?category=fish" class="banner3-item">
          <img src="/picture/banner-fish.jpg" alt="Cá cảnh"
               onerror="this.style.display='none'; this.parentNode.style.background='linear-gradient(135deg,#43cea2,#185a9d)'">
        </a>
        <a href="/products?category=hamster" class="banner3-item">
          <img src="/picture/banner-hamster.jpg" alt="Hamster"
               onerror="this.style.display='none'; this.parentNode.style.background='linear-gradient(135deg,#f7971e,#ffd200)'">
        </a>
        <a href="/products?category=reptile" class="banner3-item">
          <img src="/picture/banner-reptile.jpg" alt="Bò sát"
               onerror="this.style.display='none'; this.parentNode.style.background='linear-gradient(135deg,#56ab2f,#a8e063)'">
        </a>
      </div>
    </div>

    <!-- ===== NẾU ĐANG TÌM KIẾM: HIỆN KẾT QUẢ DẠNG GRID ===== -->
    <% if (search || category || sort) { %>
      <% if (products.length === 0) { %>
        <div class="empty-state">
          <div style="font-size: 3rem; margin-bottom: 12px;">🔍</div>
          <h4 style="color:#666;">Không tìm thấy sản phẩm phù hợp</h4>
          <a href="/products" style="display:inline-block; margin-top:12px; padding:8px 24px; background:#1a1a2e; color:#fff; border-radius:4px; text-decoration:none; font-size:0.88rem;">Xem tất cả</a>
        </div>
      <% } else { %>
        <div class="cat-section">
          <div class="cat-section-head">
            <span class="cat-section-title">Kết quả tìm kiếm (<%= products.length %> sản phẩm)</span>
            <a href="/products" class="cat-see-all">Xem tất cả ›</a>
          </div>
          <div style="display: grid; grid-template-columns: repeat(5,1fr); gap: 0;">
            <% products.forEach(p => { %>
            <div class="cat-product-card">
              <div class="cat-product-img-wrap">
                <a href="/products/<%= p._id %>">
                  <img src="<%= p.image %>" alt="<%= p.name %>" class="cat-product-img">
                </a>
              </div>
              <a href="/products/<%= p._id %>" class="cat-product-name d-block"><%= p.name %></a>
              <div><span class="cat-product-price"><%= p.price.toLocaleString('vi-VN') %>đ</span></div>
            </div>
            <% }) %>
          </div>
        </div>
      <% } %>

    <% } else { %>
    <!-- ===== HIỂN THỊ THEO DANH MỤC (mặc định) ===== -->

    <%
      // Nhóm sản phẩm theo danh mục
      const cats = [
        { key: 'fish',      label: '🐠 Cá Cảnh',         banner: '/picture/banner-vert-fish.jpg',      desc: 'Hàng trăm loài cá đẹp', color: '#1a5276' },
        { key: 'reptile',   label: '🦎 Bò Sát Cảnh',     banner: '/picture/banner-vert-reptile.jpg',   desc: 'Rồng, Rùa, Tắc kè',     color: '#1e8449' },
        { key: 'hamster',   label: '🐹 Chuột Hamster',   banner: '/picture/banner-vert-hamster.jpg',   desc: 'Hamster & phụ kiện',     color: '#784212' },
        { key: 'tank',      label: '🏘️ Bể & Lồng Nuôi', banner: '/picture/banner-vert-tank.jpg',      desc: 'Bể kính, lồng cao cấp',  color: '#154360' },
        { key: 'food',      label: '🌿 Thức Ăn',         banner: '/picture/banner-vert-food.jpg',      desc: 'Dinh dưỡng đầy đủ',     color: '#145a32' },
        { key: 'medicine',  label: '💊 Thuốc & Vitamin', banner: '/picture/banner-vert-medicine.jpg',  desc: 'Chăm sóc sức khỏe',     color: '#6c3483' },
      ];
    %>

    <% cats.forEach(cat => {
      const catProducts = products.filter(p => p.category === cat.key).slice(0, 8);
      if (catProducts.length === 0) return;
    %>
    <div class="cat-section">
      <div class="cat-section-head">
        <span class="cat-section-title"><%= cat.label %></span>
        <a href="/products?category=<%= cat.key %>" class="cat-see-all">Xem thêm ›</a>
      </div>
      <div class="cat-body">

        <!-- ẢNH DỌC BÊN TRÁI -->
        <div class="cat-banner-vert">
          <img src="<%= cat.banner %>" alt="<%= cat.label %>"
               onerror="this.style.display='none'; this.parentNode.style.background='<%= cat.color %>'">
          <div class="cat-banner-vert-overlay">
            <h3><%= cat.label.replace(/^.{2}/,'') %></h3>
            <p><%= cat.desc %></p>
            <a href="/products?category=<%= cat.key %>">Xem thêm →</a>
          </div>
        </div>

        <!-- LƯỚI SẢN PHẨM BÊN PHẢI -->
        <div class="cat-products-grid">
          <% catProducts.slice(0,8).forEach(p => { %>
          <div class="cat-product-card">
            <div class="cat-product-img-wrap">
              <a href="/products/<%= p._id %>">
                <img src="<%= p.image %>" alt="<%= p.name %>" class="cat-product-img">
              </a>
            </div>
            <a href="/products/<%= p._id %>" class="cat-product-name d-block"><%= p.name %></a>
            <div>
              <span class="cat-product-price"><%= p.price.toLocaleString('vi-VN') %>đ</span>
            </div>
          </div>
          <% }) %>
        </div>

      </div>
      <a href="/products?category=<%= cat.key %>" class="cat-more-btn">
        Xem thêm <%= cat.label %> <i class="bi bi-chevron-right" style="font-size:0.75rem;"></i>
      </a>
    </div>
    <% }) %>

    <!-- Sản phẩm chưa phân loại -->
    <%
      const knownCats = ['fish','reptile','hamster','tank','food','medicine','accessory','clothing'];
      const otherProducts = products.filter(p => !knownCats.includes(p.category)).slice(0,8);
    %>
    <% if (otherProducts.length > 0) { %>
    <div class="cat-section">
      <div class="cat-section-head">
        <span class="cat-section-title">🎯 Phụ Kiện & Khác</span>
        <a href="/products?category=accessory" class="cat-see-all">Xem thêm ›</a>
      </div>
      <div class="cat-body">
        <div class="cat-banner-vert" style="background: linear-gradient(135deg,#2c3e50,#4a6fa5);">
          <div class="cat-banner-vert-overlay">
            <h3>Phụ Kiện & Khác</h3>
            <p>Đa dạng sản phẩm</p>
            <a href="/products">Xem thêm →</a>
          </div>
        </div>
        <div class="cat-products-grid">
          <% otherProducts.forEach(p => { %>
          <div class="cat-product-card">
            <div class="cat-product-img-wrap">
              <a href="/products/<%= p._id %>">
                <img src="<%= p.image %>" alt="<%= p.name %>" class="cat-product-img">
              </a>
            </div>
            <a href="/products/<%= p._id %>" class="cat-product-name d-block"><%= p.name %></a>
            <div><span class="cat-product-price"><%= p.price.toLocaleString('vi-VN') %>đ</span></div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
    <% } %>

    <% } /* end else */ %>

  </div><!-- end container-main -->
</div><!-- end products-page -->

<script>
// ===== HERO SLIDER =====
let prodHeroCur = 0;
const prodHeroSlides = 3;
function prodHeroGoTo(n) {
  prodHeroCur = (n + prodHeroSlides) % prodHeroSlides;
  document.getElementById('prodHeroInner').style.transform = `translateX(-${prodHeroCur * 100}%)`;
  document.querySelectorAll('.hero-dot-item').forEach((d,i) =>
    d.classList.toggle('active', i === prodHeroCur));
}
function prodHeroSlide(dir) { prodHeroGoTo(prodHeroCur + dir); }
setInterval(() => prodHeroSlide(1), 5000);

// ===== TRENDING SCROLL =====
function trendScroll(dir) {
  const el = document.getElementById('trendScroll');
  el.scrollBy({ left: dir * 220, behavior: 'smooth' });
}
</script>

<%- include('partials/footer') %>