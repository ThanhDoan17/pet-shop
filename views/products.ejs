<%- include('partials/header') %>
<div class="container py-5" style="background-color: #f8f9fa;">
  
  <!-- Tiêu đề trang độc bản -->
  <div class="text-center mb-5">
    <h2 class="fw-bold text-uppercase tracking-wider" style="color: #1a1a1a; font-size: 2rem;">Danh Mục Sản Phẩm</h2>
    <div class="mx-auto" style="width: 60px; height: 4px; background: linear-gradient(90deg, #10b981, #3b82f6); border-radius: 2px;"></div>
  </div>

  <!-- Bộ lọc tìm kiếm thông minh -->
  <form method="GET" action="/products" class="bg-white rounded-4 p-4 mb-5 shadow-sm border border-light">
    <div class="row g-3 align-items-center">
      <div class="col-12 col-md-4">
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="search" value="<%= search %>" class="form-control bg-light border-start-0 ps-0" placeholder="Tìm sản phẩm, phụ kiện...">
        </div>
      </div>
      <div class="col-6 col-md-3">
        <select name="category" class="form-select bg-light border-0 py-2">
          <option value="">Tất cả danh mục</option>
          <option value="tank" <%= category === 'tank' ? 'selected' : '' %>>🏘️ Bể & Lồng nuôi</option>
          <option value="food" <%= category === 'food' ? 'selected' : '' %>>🌿 Thức ăn</option>
          <option value="accessory" <%= category === 'accessory' ? 'selected' : '' %>>🎯 Phụ kiện</option>
          <option value="reptile" <%= category === 'reptile' ? 'selected' : '' %>>🦎 Bò sát cảnh</option>
          <option value="hamster" <%= category === 'hamster' ? 'selected' : '' %>>🐹 Chuột Hamster</option>
          <option value="medicine" <%= category === 'medicine' ? 'selected' : '' %>>💊 Thuốc & Vitamin</option>
          <option value="clothing" <%= category === 'clothing' ? 'selected' : '' %>>👗 Quần áo thú cưng</option>
          <option value="fish" <%= category === 'fish' ? 'selected' : '' %>>🐠 Cá</option>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <select name="sort" class="form-select bg-light border-0 py-2">
          <option value="">Mặc định sắp xếp</option>
          <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Giá: Thấp đến Cao</option>
          <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Giá: Cao đến Thấp</option>
        </select>
      </div>
      <div class="col-12 col-md-2">
        <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold rounded-3 transition-all">Áp dụng lọc</button>
      </div>
    </div>
  </form>

  <!-- Danh sách lưới sản phẩm đồng đều -->
  <% if (products.length === 0) { %>
    <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
      <div class="display-1 text-muted mb-3"><i class="bi bi-emoji-frown"></i></div>
      <h4 class="text-secondary fw-medium">Rất tiếc, không tìm thấy sản phẩm phù hợp</h4>
      <a href="/products" class="btn btn-outline-dark mt-3 px-4 py-2 rounded-pill">Quay lại xem tất cả</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% products.forEach(product => { %>
        <div class="col-6 col-md-4 col-lg-3 d-flex align-items-stretch">
          <div class="card h-100 w-100 border-0 rounded-4 shadow-hover overflow-hidden d-flex flex-column transition-transform" style="background: #ffffff;">
            
            <!-- Vùng ảnh sản phẩm cố định tỷ lệ -->
            <div class="position-relative overflow-hidden group" style="padding-top: 100%; background: #fdfdfd;">
              <a href="/products/<%= product._id %>" class="position-absolute top-0 start-0 w-100 h-100">
                <img src="<%= product.image %>" alt="<%= product.name %>" class="w-100 h-100 img-fluid transition-scale" style="object-fit: cover; position: absolute; top:0; left:0;">
              </a>
            </div>

            <!-- Thân thẻ thông tin sản phẩm -->
            <div class="card-body p-3 d-flex flex-column justify-content-between flex-grow-1">
              <div>
                <h5 class="card-title text-dark fw-semibold text-truncate-2 mb-1" style="font-size: 0.95rem; line-height: 1.4; min-height: 2.8rem;">
                  <%= product.name %>
                </h5>
                <!-- Điểm đánh giá sao mô phỏng (Sẽ được xử lý động ở bước sau) -->
                <div class="text-warning small mb-2">
                  <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                  <span class="text-muted ms-1" style="font-size: 0.8rem;">(4.5)</span>
                </div>
              </div>
              
              <div class="mt-auto pt-2">
                <div class="fw-bold text-danger mb-2" style="font-size: 1.1rem;">
                  <%= product.price.toLocaleString('vi-VN') %> <span style="font-size: 0.85rem; vertical-align: super;">đ</span>
                </div>
                <a href="/products/<%= product._id %>" class="btn btn-outline-primary btn-sm w-100 py-2 fw-medium rounded-3">
                  <i class="bi bi-eye me-1"></i> Chi tiết sản phẩm
                </a>
              </div>
            </div>

          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Khối mã lệnh CSS bổ sung nhằm tối ưu hiệu ứng hiển thị -->
<style>
  .shadow-hover {
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    border: 1px solid rgba(0,0,0,0.03) !important;
  }
  .shadow-hover:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 20px rgba(0, 0, 0, 0.08) !important;
  }
  .text-truncate-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;  
    overflow: hidden;
  }
  .transition-scale {
    transition: transform 0.5s ease;
  }
  .card:hover .transition-scale {
    transform: scale(1.06);
  }
</style>
<%- include('partials/footer') %>
