<%- include('partials/header') %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.min.css">

<style>
.revenue-hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
  color: white; padding: 80px 0 60px; text-align: center;
}
.revenue-hero h1 { font-family: var(--font-display); font-size: 2.8rem; font-weight: 700; margin-bottom: 12px; }
.revenue-hero p { color: rgba(255,255,255,.7); font-size: 1rem; }

.revenue-section { padding: 60px 0; }
.revenue-section--alt { background: var(--gray-1); }

.kpi-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; margin-bottom: 48px; }
.kpi-card {
  background: white; border-radius: var(--radius); padding: 28px 24px;
  box-shadow: var(--shadow-sm); text-align: center;
  border-top: 4px solid var(--green);
  transition: transform var(--transition), box-shadow var(--transition);
}
.kpi-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.kpi-icon { font-size: 2rem; margin-bottom: 12px; display: block; }
.kpi-value { font-size: 1.6rem; font-weight: 800; color: var(--dark); display: block; margin-bottom: 4px; }
.kpi-label { font-size: .82rem; color: var(--gray-4); font-weight: 500; }
.kpi-card:nth-child(2) { border-top-color: var(--orange); }
.kpi-card:nth-child(3) { border-top-color: #3498db; }
.kpi-card:nth-child(4) { border-top-color: var(--red); }

.chart-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 24px; }
.chart-card {
  background: white; border-radius: var(--radius);
  box-shadow: var(--shadow-sm); padding: 28px; overflow: hidden;
}
.chart-card h4 {
  font-weight: 700; color: var(--dark); margin-bottom: 20px;
  font-size: 1rem; display: flex; align-items: center; gap: 8px;
}
.chart-card h4 span { font-size: 1.2rem; }
.chart-full { grid-column: 1 / -1; }

.reveal { opacity: 0; transform: translateY(30px); transition: opacity .7s ease, transform .7s ease; }
.reveal.revealed { opacity: 1; transform: none; }

.month-names { display: grid; grid-template-columns: repeat(12,1fr); gap: 4px; margin-top: 8px; }
.month-name { text-align: center; font-size: .72rem; color: var(--gray-4); }

@media (max-width: 1024px) {
  .kpi-grid { grid-template-columns: repeat(2,1fr); }
  .chart-grid { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .kpi-grid { grid-template-columns: 1fr 1fr; }
  .revenue-hero h1 { font-size: 1.8rem; }
}
</style>

<!-- HERO -->
<div class="revenue-hero">
  <div class="container">
    <h1>📊 Thống kê doanh thu</h1>
    <p>Tổng quan hoạt động kinh doanh của PESTshop LTD — Năm <%= year %></p>
  </div>
</div>

<section class="revenue-section">
  <div class="container">

    <!-- KPI CARDS -->
    <div class="kpi-grid reveal">
      <div class="kpi-card">
        <span class="kpi-icon">💰</span>
        <span class="kpi-value" id="kpi-revenue">0 đ</span>
        <div class="kpi-label">Tổng doanh thu <%= year %></div>
      </div>
      <div class="kpi-card">
        <span class="kpi-icon">📦</span>
        <span class="kpi-value" id="kpi-orders">0</span>
        <div class="kpi-label">Tổng đơn hàng</div>
      </div>
      <div class="kpi-card">
        <span class="kpi-icon">📈</span>
        <span class="kpi-value" id="kpi-avg">0 đ</span>
        <div class="kpi-label">Doanh thu trung bình / đơn</div>
      </div>
      <div class="kpi-card">
        <span class="kpi-icon">🏆</span>
        <span class="kpi-value" id="kpi-best">—</span>
        <div class="kpi-label">Tháng doanh thu cao nhất</div>
      </div>
    </div>

    <!-- CHARTS ROW 1 -->
    <div class="chart-grid reveal">
      <div class="chart-card">
        <h4><span>📅</span> Doanh thu theo tháng (<%= year %>)</h4>
        <canvas id="chartMonthly" height="280"></canvas>
      </div>
      <div class="chart-card">
        <h4><span>🥧</span> Cơ cấu doanh thu</h4>
        <canvas id="chartPie" height="280"></canvas>
      </div>
    </div>

    <!-- CHARTS ROW 2 -->
    <div class="chart-grid reveal">
      <div class="chart-card chart-full">
        <h4><span>📆</span> Doanh thu theo năm</h4>
        <canvas id="chartYearly" height="180"></canvas>
      </div>
    </div>

    <!-- TOP PRODUCTS -->
    <div class="chart-card reveal">
      <h4><span>🔥</span> Top sản phẩm doanh thu cao nhất</h4>
      <canvas id="chartTop" height="160"></canvas>
    </div>

  </div>
</section>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const monthlyStats  = <%- monthlyStats %>;
const yearlyStats   = <%- yearlyStats %>;
const categoryStats = <%- categoryStats %>;
const totalRevenue  = <%= totalRevenue %>;
const totalOrders   = <%= totalOrders %>;

const MONTHS = ['T1','T2','T3','T4','T5','T6','T7','T8','T9','T10','T11','T12'];
const GREEN  = '#2ecc71';
const ORANGE = '#e67e22';
const DARK   = '#1a1a2e';
const COLORS = ['#2ecc71','#3498db','#e67e22','#e74c3c','#9b59b6','#1abc9c','#f39c12','#34495e'];

/* ===== KPI COUNTER ANIMATION ===== */
function animateCount(el, target, prefix='', suffix='') {
  let start = 0;
  const step = target / 60;
  const timer = setInterval(() => {
    start += step;
    if (start >= target) { start = target; clearInterval(timer); }
    el.textContent = prefix + Math.floor(start).toLocaleString('vi-VN') + suffix;
  }, 16);
}

window.addEventListener('load', () => {
  const avg = totalOrders > 0 ? Math.round(totalRevenue / totalOrders) : 0;
  const bestMonth = monthlyStats.reduce((b, m) => m.revenue > (b?.revenue || 0) ? m : b, null);

  animateCount(document.getElementById('kpi-revenue'), totalRevenue, '', ' đ');
  animateCount(document.getElementById('kpi-orders'), totalOrders, '', ' đơn');
  animateCount(document.getElementById('kpi-avg'), avg, '', ' đ');
  if (bestMonth) document.getElementById('kpi-best').textContent = 'Tháng ' + bestMonth._id;
});

/* ===== CHART DEFAULTS ===== */
Chart.defaults.font.family = "'Be Vietnam Pro', sans-serif";
Chart.defaults.color = '#6c757d';

/* ===== MONTHLY BAR CHART ===== */
const monthlyData = Array(12).fill(0);
const ordersData  = Array(12).fill(0);
monthlyStats.forEach(m => {
  monthlyData[m._id - 1] = m.revenue;
  ordersData[m._id - 1]  = m.orders;
});

new Chart(document.getElementById('chartMonthly'), {
  type: 'bar',
  data: {
    labels: MONTHS,
    datasets: [
      {
        label: 'Doanh thu (đ)',
        data: monthlyData,
        backgroundColor: COLORS[0] + 'cc',
        borderColor: COLORS[0],
        borderWidth: 2,
        borderRadius: 8,
        yAxisID: 'y'
      },
      {
        label: 'Số đơn',
        data: ordersData,
        type: 'line',
        borderColor: ORANGE,
        backgroundColor: ORANGE + '22',
        borderWidth: 2,
        pointBackgroundColor: ORANGE,
        pointRadius: 4,
        tension: 0.4,
        fill: true,
        yAxisID: 'y1'
      }
    ]
  },
  options: {
    responsive: true,
    interaction: { mode: 'index', intersect: false },
    plugins: {
      legend: { position: 'top' },
      tooltip: {
        callbacks: {
          label: ctx => ctx.datasetIndex === 0
            ? ' ' + ctx.raw.toLocaleString('vi-VN') + ' đ'
            : ' ' + ctx.raw + ' đơn'
        }
      }
    },
    scales: {
      y: {
        type: 'linear', position: 'left',
        ticks: { callback: v => (v/1000000).toFixed(0) + 'M' },
        grid: { color: '#f0f0f0' }
      },
      y1: {
        type: 'linear', position: 'right',
        grid: { drawOnChartArea: false },
        ticks: { stepSize: 1 }
      }
    }
  }
});

/* ===== PIE CHART ===== */
const pieLabels = monthlyStats.map(m => 'Tháng ' + m._id);
const pieData   = monthlyStats.map(m => m.revenue);

new Chart(document.getElementById('chartPie'), {
  type: 'doughnut',
  data: {
    labels: pieLabels.length ? pieLabels : ['Chưa có dữ liệu'],
    datasets: [{
      data: pieData.length ? pieData : [1],
      backgroundColor: COLORS,
      borderWidth: 2,
      borderColor: '#fff',
      hoverOffset: 8
    }]
  },
  options: {
    responsive: true,
    cutout: '60%',
    plugins: {
      legend: { position: 'bottom', labels: { padding: 12, font: { size: 11 } } },
      tooltip: {
        callbacks: {
          label: ctx => ' ' + ctx.raw.toLocaleString('vi-VN') + ' đ'
        }
      }
    }
  }
});

/* ===== YEARLY BAR CHART ===== */
new Chart(document.getElementById('chartYearly'), {
  type: 'bar',
  data: {
    labels: yearlyStats.map(y => 'Năm ' + y._id),
    datasets: [{
      label: 'Doanh thu (đ)',
      data: yearlyStats.map(y => y.revenue),
      backgroundColor: COLORS.map(c => c + 'cc'),
      borderColor: COLORS,
      borderWidth: 2,
      borderRadius: 8
    }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { display: false },
      tooltip: { callbacks: { label: ctx => ' ' + ctx.raw.toLocaleString('vi-VN') + ' đ' } }
    },
    scales: {
      y: {
        ticks: { callback: v => (v/1000000).toFixed(0) + 'M đ' },
        grid: { color: '#f0f0f0' }
      }
    }
  }
});

/* ===== TOP PRODUCTS HORIZONTAL BAR ===== */
new Chart(document.getElementById('chartTop'), {
  type: 'bar',
  data: {
    labels: categoryStats.map(c => c._id ? c._id.substring(0,30) : 'Không rõ'),
    datasets: [{
      label: 'Doanh thu (đ)',
      data: categoryStats.map(c => c.revenue),
      backgroundColor: COLORS.map(c => c + 'cc'),
      borderColor: COLORS,
      borderWidth: 2,
      borderRadius: 6
    }]
  },
  options: {
    indexAxis: 'y',
    responsive: true,
    plugins: {
      legend: { display: false },
      tooltip: { callbacks: { label: ctx => ' ' + ctx.raw.toLocaleString('vi-VN') + ' đ' } }
    },
    scales: {
      x: {
        ticks: { callback: v => (v/1000000).toFixed(1) + 'M' },
        grid: { color: '#f0f0f0' }
      }
    }
  }
});

/* ===== SCROLL REVEAL ===== */
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('revealed'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>

<style>
  .role-avatar-admin { background-color: #ef4444; }
  .role-avatar-staff { background-color: #3b82f6; }
  .role-avatar-user  { background-color: #10b981; } /* Giá trị mặc định mặc định */
</style>
