<script>
/* HERO SLIDER */
let hCurrent = 0;
const hSlides = document.querySelectorAll('.hero-slide');
const hDots   = document.querySelectorAll('.hero-dot');
function heroGoTo(n) {
  hSlides[hCurrent].classList.remove('active');
  hDots[hCurrent].classList.remove('active');
  hCurrent = (n + hSlides.length) % hSlides.length;
  hSlides[hCurrent].classList.add('active');
  hDots[hCurrent].classList.add('active');
}
function heroSlide(dir) { heroGoTo(hCurrent + dir); }
setInterval(() => heroSlide(1), 6000);

/* COUNTDOWN */
function updateCountdown() {
  const now = new Date(), end = new Date();
  end.setHours(23, 59, 59, 0);
  const d = end - now;
  document.getElementById('cd-h').textContent = String(Math.floor(d/3600000)).padStart(2,'0');
  document.getElementById('cd-m').textContent = String(Math.floor((d%3600000)/60000)).padStart(2,'0');
  document.getElementById('cd-s').textContent = String(Math.floor((d%60000)/1000)).padStart(2,'0');
}
setInterval(updateCountdown, 1000); updateCountdown();

/* TOPBAR CLOCK */
function updateClock() {
  const now = new Date();
  document.getElementById('topbar-time').textContent =
    now.toLocaleTimeString('vi-VN', {hour:'2-digit', minute:'2-digit'});
}
setInterval(updateClock, 1000); updateClock();

/* SCROLL REVEAL */
const revealObs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('revealed'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

/* PRODUCT CARD */
function productCard(p) {
  const isLoggedIn = document.body.dataset.loggedIn === 'true';
  const badge = isLoggedIn
    ? `<span class="pcard-badge pcard-badge--discount">GIẢM 10%</span>`
    : `<span class="pcard-badge pcard-badge--register">ĐĂNG KÝ TÀI KHOẢN -10%</span>`;
  return `
  <div class="pcard">
    <a href="/products/${p._id}" class="pcard-img-wrap">
      <img src="${p.image}" alt="${p.name}" loading="lazy">
      <span class="pcard-badge">Mới</span>
      ${badge}
    </a>
    <div class="pcard-body">
      <p class="pcard-name">${p.name}</p>
      <p class="pcard-price">${p.price.toLocaleString('vi-VN')} đ</p>
      <a href="/products/${p._id}" class="pcard-btn">Xem chi tiết</a>
    </div>
  </div>`;
}

/* LOAD PRODUCTS */
fetch('/api/featured-products')
  .then(r => r.json())
  .then(products => {
    document.getElementById('featured-products').innerHTML =
      products.length ? products.map(productCard).join('') : '<p class="no-products">Chưa có sản phẩm.</p>';

    const fish = products.filter(p => p.category === 'fish').slice(0,4);
    document.getElementById('showcase-fish').innerHTML =
      (fish.length ? fish : products.slice(0,4)).map(productCard).join('');

    const rep = products.filter(p => p.category === 'reptile').slice(0,4);
    document.getElementById('showcase-reptile').innerHTML =
      (rep.length ? rep : products.slice(0,4)).map(productCard).join('');
  })
  .catch(() => {
    document.getElementById('featured-products').innerHTML = '<p class="no-products">Không thể tải sản phẩm.</p>';
  });

/* CHATBOT */
const faqData = {
  'gio-mo-cua': 'Cửa hàng mở cửa từ <b>8:00 – 21:30</b> tất cả các ngày trong tuần! 🎉',
  'van-chuyen': 'Giao hàng <b>toàn quốc 2-3 ngày</b>. Miễn phí từ <b>200.000đ</b>.',
  'doi-tra': 'Đổi trả miễn phí trong <b>7 ngày</b> nếu sản phẩm lỗi.',
  'san-pham': '🐠 Cá cảnh, 🦎 Bò sát, 🐹 Hamster, 🌿 Thức ăn, 🏘️ Bể & Lồng, 💊 Thuốc, 🎯 Phụ kiện, 👗 Quần áo.',
  'lien-he': '📞 <b>098.539.5024</b><br>✉️ <b>thanhdoankx@gmail.com</b>',
  'thanh-toan': '💵 COD, 🏦 Chuyển khoản, 💳 Visa/Mastercard.'
};
const faqLabels = {
  'gio-mo-cua':'Giờ mở cửa?','van-chuyen':'Vận chuyển?',
  'doi-tra':'Đổi trả?','san-pham':'Sản phẩm gì?',
  'lien-he':'Liên hệ?','thanh-toan':'Thanh toán?'
};

function toggleChat() { document.getElementById('chatbot').classList.toggle('open'); }

function addMsg(html, type) {
  const msgs = document.getElementById('chat-messages');
  const d = document.createElement('div');
  d.className = `chat-msg chat-msg--${type}`;
  d.innerHTML = html;
  msgs.appendChild(d);
  msgs.scrollTop = msgs.scrollHeight;
}

function askBot(key) {
  addMsg(faqLabels[key], 'user');
  setTimeout(() => addMsg(faqData[key] || 'Vui lòng gọi <b>098.539.5024</b>!', 'bot'), 350);
}

function sendChat() {
  const input = document.getElementById('chat-input');
  const text = input.value.trim();
  if (!text) return;
  addMsg(text, 'user');
  input.value = '';
  const t = text.toLowerCase();
  let reply = 'Vui lòng gọi <b>098.539.5024</b> để hỗ trợ trực tiếp!';
  if (t.includes('giờ')||t.includes('mở')) reply = faqData['gio-mo-cua'];
  else if (t.includes('ship')||t.includes('giao')) reply = faqData['van-chuyen'];
  else if (t.includes('đổi')||t.includes('trả')) reply = faqData['doi-tra'];
  else if (t.includes('sản phẩm')||t.includes('bán')) reply = faqData['san-pham'];
  else if (t.includes('thanh toán')||t.includes('cod')) reply = faqData['thanh-toan'];
  else if (t.includes('liên hệ')||t.includes('điện thoại')) reply = faqData['lien-he'];
  setTimeout(() => addMsg(reply, 'bot'), 350);
}
</script>