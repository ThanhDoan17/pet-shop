}
.index-search-form { max-width: 720px; margin: 0 auto; }
.index-search-input-group {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 4px;
  padding: 3px 3px 3px 14px;
  transition: box-shadow 0.2s;
}
.index-search-input-group:focus-within {
  box-shadow: 0 0 0 3px rgba(13,110,253,0.3);
}
.search-icon-anchor {
  color: #999; font-size: 1rem; margin-right: 6px; flex-shrink: 0;
}
/* DROPDOWN MỚI */
.search-category-select {
  border: none; outline: none;
  background: transparent;
  font-size: 0.85rem;
  color: #444;
  cursor: pointer;
  padding: 6px 4px;
  max-width: 130px;
  flex-shrink: 0;
}
.search-vdivider {
  width: 1px; height: 20px;
  background: #e0e0e0;
  margin: 0 8px;
  flex-shrink: 0;
}
.index-search-input-group input {
  flex: 1; border: none;
  background: transparent; outline: none;
  font-size: 0.9rem; color: #212121;
  padding: 8px 0; min-width: 0;
}
.index-search-input-group input::placeholder { color: #bbb; }
.index-search-input-group button {
  background: #0d6efd; color: #fff;
