}
/* ===== CARD TỪNG DANH MỤC ===== */
.popcat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: #333;
  transition: transform 0.22s ease;
}
.popcat-card:hover { transform: translateY(-4px); color: #0d6efd; }
.popcat-img-wrap {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 10px;
  overflow: hidden;
  position: relative;
  background: #f5f5f5;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  transition: box-shadow 0.22s;
}
.popcat-card:hover .popcat-img-wrap {
  box-shadow: 0 6px 20px rgba(13,110,253,0.18);
}
.popcat-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
  display: block;
}
.popcat-card:hover .popcat-img-wrap img { transform: scale(1.07); }
.popcat-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.28) 0%, transparent 60%);
  opacity: 0;
  transition: opacity 0.25s;
}
.popcat-card:hover .popcat-overlay { opacity: 1; }
.popcat-label {
  font-size: 0.82rem;
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
