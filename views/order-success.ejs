<%- include('partials/header') %>
<div class="container py-5">
  <div class="success-box">
    <div class="icon">✅</div>
    <h2 class="fw-bold mt-3">Đặt hàng thành công!</h2>
    <p class="text-muted">Cảm ơn bạn đã mua hàng tại PetShop LTD</p>
    <div class="bg-light rounded-3 p-4 my-4 text-start d-inline-block">
      <p class="mb-1"><strong>Mã đơn hàng:</strong> #<%= order._id.toString().slice(-6).toUpperCase() %></p>
      <p class="mb-1"><strong>Tổng tiền:</strong> <span class="text-warning fw-bold"><%= order.totalPrice.toLocaleString('vi-VN') %> đ</span></p>
      <p class="mb-0"><strong>Trạng thái:</strong> <span class="badge bg-warning text-dark">Chờ xử lý</span></p>
    </div>
    <div class="mt-3">
      <a href="/orders/my-orders" class="btn btn-primary me-2">Xem đơn hàng</a>
      <a href="/products" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>