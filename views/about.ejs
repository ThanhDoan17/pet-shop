<%- include('partials/header') %>

<style>
/* ĐỒNG BỘ MÀU SẮC CHỦ ĐẠO & HỆ THỐNG PHÔNG CHỮ */
:root {
  --amazon-orange: #ff9900;
  --amazon-dark: #131921;
  --text-dark: #1a1a1a;
  --bg-light: #f8f9fa;
  --border-color: #e5e7eb;
}

.about-page-container {
  background-color: #ffffff;
  color: var(--text-dark);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  padding-bottom: 80px;
}

/* KHỐI TIÊU ĐỀ TRANG CHỦ ĐẠO (AMAZON NEWS STYLE) */
.news-brand-header {
  border-bottom: 1px solid var(--border-color);
  padding: 20px 0;
  margin-bottom: 30px;
}
.news-brand-title {
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--text-dark);
  margin: 0;
}
.news-brand-title span {
  color: var(--amazon-orange);
}

/* LƯỚI SHOWCASE TIÊU ĐIỂM (GRID 2 CỘT LỚN) */
.showcase-main-grid {
  display: grid;
  grid-template-columns: 2.2fr 1fr;
  gap: 30px;
  margin-bottom: 50px;
}

/* KHỐI BANNER CHÍNH BÊN TRÁI (HERO BANNER) */
.hero-news-banner {
  cursor: pointer;
}
.hero-news-image-box {
  width: 100%;
  height: 420px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 20px;
  background-color: #eee;
}
.hero-news-image-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.hero-news-banner:hover .hero-news-image-box img {
  transform: scale(1.02);
}
.hero-news-title {
  font-size: 2rem;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 12px;
  color: var(--text-dark);
}
.hero-news-desc {
  font-size: 1.05rem;
  color: #4b5563;
  line-height: 1.6;
}

/* KHỐI TIN PHỤ BÊN PHẢI (SIDEBAR CARDS) */
.sidebar-news-stack {
  display: flex;
  flex-direction: column;
  gap: 25px;
}
.side-news-card {
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 20px;
}
.side-news-card:last-child {
  border-bottom: none;
}
.side-image-box {
  width: 100%;
  height: 180px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
}
.side-image-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.side-news-title {
  font-size: 1.15rem;
  font-weight: 700;
  line-height: 1.4;
  color: var(--text-dark);
  margin-bottom: 6px;
}
.side-news-date {
  font-size: 0.8rem;
  color: #6b7280;
}

/* KHỐI DANH MỤC ĐỔI MỚI & SÁNG TẠO (INNOVATION AND AI GRID) */
.section-divider-title {
  font-size: 1.4rem;
  font-weight: 800;
  border-bottom: 2px solid var(--text-dark);
  padding-bottom: 10px;
  margin-bottom: 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.section-divider-title a {
  font-size: 0.9rem;
  color: #2563eb;
  text-decoration: none;
}

.innovation-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.innovation-card {
  display: flex;
  flex-direction: column;
}
.innovation-image-box {
  width: 100%;
  height: 160px;
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 15px;
  background-color: #eee;
}
.innovation-image-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.innovation-card-title {
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 1.4;
  color: var(--text-dark);
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;  
  overflow: hidden;
  height: 4.2rem;
}
.innovation-card-date {
  font-size: 0.8rem;
  color: #9ca3af;
  margin-top: auto;
}

/* CẤU TRÚC ĐÁNH GIÁ SỐ LIỆU THỐNG KÊ RÚT GỌN */
.stats-strip-wrapper {
  background-color: var(--bg-light);
  border-radius: 12px;
  padding: 30px;
  margin-top: 50px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  text-align: center;
}
.stat-item-number {
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--amazon-orange);
}
.stat-item-label {
  font-size: 0.9rem;
  color: #4b5563;
  font-weight: 500;
}

/* ĐÁP ỨNG GIAO DIỆN DI ĐỘNG (RESPONSIVE) */
@media (max-width: 992px) {
  .showcase-main-grid {
    grid-template-columns: 1fr;
  }
  .innovation-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 576px) {
  .innovation-grid {
    grid-template-columns: 1fr;
  }
  .stats-strip-wrapper {
    grid-template-columns: 1fr;
    gap: 25px;
  }
  .hero-news-image-box {
    height: 260px;
  }
}
</style>

<div class="about-page-container">
  <div class="container">
    
