<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Pestshop LTD</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body data-logged-in="<%= typeof user !== 'undefined' && user ? 'true' : 'false' %>">
<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container">
    <a class="navbar-brand" href="/"><i class="bi bi-water"></i> PEST<span>shop</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
    
      <ul class="navbar-nav me-auto">
        <% if (!user || user.role === 'user' || user.role === 'customer') { %>
<li class="nav-item">
  <a class="nav-link" href="/about">
    <i class="bi bi-info-circle me-1"></i>Giới thiệu
  </a>
</li>
          
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Sản phẩm</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/products">🛍️ Tất cả</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/products?category=tank">🏘️ Bể & Lồng nuôi</a></li>
              <li><a class="dropdown-item" href="/products?category=food">🌿 Thức ăn</a></li>
              <li><a class="dropdown-item" href="/products?category=accessory">🎯 Phụ kiện</a></li>
              <li><a class="dropdown-item" href="/products?category=reptile">🦎 Bò sát cảnh</a></li>
              <li><a class="dropdown-item" href="/products?category=hamster">🐹 Chuột Hamster</a></li>
              <li><a class="dropdown-item" href="/products?category=medicine">💊 Thuốc & Vitamin</a></li>
              <li><a class="dropdown-item" href="/products?category=clothing">👗 Quần áo thú cưng</a></li>
              <li><a class="dropdown-item" href="/products?category=fish">🐠 Cá</a></li>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/warranty">
              <i class="bi bi-shield-check me-1"></i>Chính sách bảo hành
            </a>
        <% } %>
      </ul>

      <!-- Cụm chức năng Giỏ hàng và Tài khoản (Bên phải) -->
      <ul class="navbar-nav ms-auto align-items-center">
        <!-- Giỏ hàng -->
        <% if (!user || user.role === 'user' || user.role === 'customer') { %>
          <li class="nav-item me-2">
            <a class="nav-link" href="/cart">
              <i class="bi bi-cart3"></i>
              <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
                <span class="cart-badge"><%= cartCount %></span>
              <% } %>
            </a>
          </li>
        <% } %>

        <!-- Menu tài khoản & đăng nhập -->
        <% if (typeof user !== 'undefined' && user) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle"></i> <%= user.name %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <% if (user.role === 'admin') { %>
                <li><a class="dropdown-item" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li><a class="dropdown-item" href="/admin/products"><i class="bi bi-box"></i> Sản phẩm</a></li>
                <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people"></i> Người dùng</a></li>
                <li><a class="dropdown-item" href="/admin/orders"><i class="bi bi-bag"></i> Đơn hàng</a></li>
                <li><a class="dropdown-item" href="/admin/reviews"><i class="bi bi-chat-square-text"></i> Phản hồi đánh giá</a></li>
                <li><a class="dropdown-item" href="/admin/statistics"><i class="bi bi-bar-chart"></i> Thống kê</a></li>
                <li><hr class="dropdown-divider"></li>
              <% } %>
              <% if (user.role === 'staff') { %>
                <li><a class="dropdown-item" href="/staff/inventory"><i class="bi bi-boxes"></i> Tồn kho</a></li>
                <li><a class="dropdown-item" href="/staff/products/add"><i class="bi bi-plus-circle"></i> Thêm sản phẩm</a></li>
                <li><a class="dropdown-item" href="/staff/orders"><i class="bi bi-bag-check"></i> Đơn hàng</a></li>
                <li><hr class="dropdown-divider"></li>
              <% } %>
              
             <!-- THAY THẾ ĐOẠN ĐƠN HÀNG CỦA TÔI CŨ BẰNG ĐOẠN NÀY -->
<% if (user.role === 'user' || user.role === 'customer') { %>
  <li>
    <a class="dropdown-item" href="/orders/my-orders" onclick="event.preventDefault(); window.location.href='/orders/my-orders';">
      <i class="bi bi-bag"></i> Đơn hàng của tôi
    </a>
  </li>
<% } %>

              
              <li><a class="dropdown-item" href="/auth/change-password"><i class="bi bi-key"></i> Đổi mật khẩu</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a></li>
            </ul>
          </li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/auth/login">Đăng nhập</a></li>
          <li class="nav-item"><a class="btn btn-primary btn-sm ms-2" href="/auth/register">Đăng ký</a></li>
        <% } %>
      </ul>

    </div>
  </div>
</nav>
