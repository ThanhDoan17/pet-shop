<%- include('partials/header') %>
<div class="container py-5" style="background-color: #f8f9fa;">
  
  <!-- Nút quay lại & Điều hướng nhanh -->
  <nav aria-label="breadcrumb" class="mb-4">
    <a href="/products" class="btn btn-sm btn-light border shadow-sm rounded-pill px-3 fw-medium">
      <i class="bi bi-arrow-left me-1"></i> Quay lại cửa hàng
    </a>
  </nav>

  <!-- KHỐI CHI TIẾT SẢN PHẨM CAO CẤP -->
  <div class="bg-white rounded-4 shadow-sm p-4 p-md-5 border border-light mb-5">
    <div class="row g-5">
      <!-- Vùng ảnh sản phẩm -->
      <div class="col-12 col-md-5 text-center d-flex align-items-center justify-content-center bg-light rounded-4 overflow-hidden position-relative" style="min-height: 380px;">
        <img src="<%= product.image %>" alt="<%= product.name %>" class="img-fluid rounded-3 transform-hover" style="max-height: 350px; object-fit: contain; transition: transform 0.3s ease;">
      </div>
      
      <!-- Vùng thông tin bán hàng -->
      <div class="col-12 col-md-7 d-flex flex-column justify-content-between">
        <div>
          <h1 class="h2 fw-bold text-dark mb-2" style="letter-spacing: -0.5px;"><%= product.name %></h1>
          
          <!-- Điểm đánh giá sao dựa trên tỉ lệ khách hàng thực tế -->
          <div class="d-flex align-items-center mb-3 gap-2">
            <div class="text-warning fs-5">
              <% 
                let avgRating = 0;
                if (typeof reviews !== 'undefined' && reviews.length > 0) {
                  let total = reviews.reduce((sum, r) => sum + r.rating, 0);
                  avgRating = (total / reviews.length).toFixed(1);
                }
                let fullStars = Math.floor(avgRating);
                let hasHalf = avgRating - fullStars >= 0.5;
              %>
              <% for(let i=1; i<=5; i++) { %>
                <% if(i <= fullStars) { %>
                  <i class="bi bi-star-fill"></i>
                <% } else if(i === fullStars + 1 && hasHalf) { %>
                  <i class="bi bi-star-half"></i>
                <% } else { %>
                  <i class="bi bi-star"></i>
                <% } %>
              <% } %>
            </div>
            <span class="fw-bold text-dark pt-1"><%= avgRating > 0 ? avgRating : 'Chưa có' %></span>
            <span class="text-muted pt-1">|</span>
            <span class="text-secondary pt-1" style="font-size: 0.9rem;">(<%= typeof reviews !== 'undefined' ? reviews.length : 0 %> đánh giá từ khách hàng)</span>
          </div>

          <!-- Khối hiển thị giá tiền -->
          <div class="p-3 bg-light rounded-3 my-4 d-inline-block w-100">
            <span class="text-muted small d-block mb-1">Giá bán hiện tại</span>
            <span class="fs-1 fw-extrabold text-danger m-0"><%= product.price.toLocaleString('vi-VN') %> <span style="font-size: 1.2rem; vertical-align: middle;">đ</span></span>
          </div>

          <!-- Sửa lỗi: Hiển thị mô tả dãn cách đẹp mắt và hỗ trợ xuống dòng tự nhiên -->
          <div class="mb-4">
            <h6 class="fw-bold text-secondary text-uppercase small mb-2">Mô tả chi tiết sản phẩm</h6>
            <div class="text-dark border-start border-3 border-primary ps-3 my-2" style="white-space: pre-line; line-height: 1.6; font-size: 0.98rem; text-align: justify;">
              <%= product.description %>
            </div>
          </div>
        </div>

        <div>
          <!-- Trạng thái kho hàng -->
          <div class="mb-3">
            <% if (product.stock > 0) { %>
              <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Còn <%= product.stock %> sản phẩm khả dụng</span>
            <% } else { %>
              <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> Tạm hết hàng</span>
            <% } %>
          </div>

          <!-- Form đặt hàng chuyên nghiệp -->
          <% if (product.stock > 0) { %>
            <form method="POST" action="/cart/add" class="d-flex flex-wrap gap-3 align-items-center mt-3">
              <input type="hidden" name="productId" value="<%= product._id %>">
              <div class="input-group border rounded-3" style="width: 130px; height: 46px;">
                <button type="button" class="btn btn-link text-dark text-decoration-none px-2 border-end" onclick="this.parentNode.querySelector('input[type=number]').stepDown()"><i class="bi bi-dash-lg"></i></button>
                <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>" class="form-control border-0 text-center bg-transparent fw-bold text-dark" required>
                <button type="button" class="btn btn-link text-dark text-decoration-none px-2 border-start" onclick="this.parentNode.querySelector('input[type=number]').stepUp()"><i class="bi bi-plus-lg"></i></button>
              </div>
              <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm flex-grow-1 flex-md-grow-0" style="height: 46px;"><i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ hàng</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- THANH CUỐN NGANG SẢN PHẨM LIÊN QUAN -->
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
      <h3 class="fw-bold m-0" style="font-size: 1.4rem;"><i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Sản phẩm liên quan</h3>
      <span class="text-muted small">Kéo ngang để xem <i class="bi bi-arrow-right-short"></i></span>
    </div>
    
    <div class="d-flex overflow-x-auto gap-3 pb-3 scrollbar-hidden" style="scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;">
      <% if (typeof relatedProducts !== 'undefined' && relatedProducts.length > 0) { %>
        <% relatedProducts.forEach(item => { %>
          <div class="bg-white rounded-3 p-3 border shadow-sm d-flex flex-column justify-content-between flex-shrink-0" style="width: 220px; scroll-snap-align: start;">
            <a href="/products/<%= item._id %>" class="text-center d-block mb-2 overflow-hidden rounded-2" style="height: 150px;">
              <img src="<%= item.image %>" alt="<%= item.name %>" class="w-100 h-100 object-fit-cover transition-all">
            </a>
            <div>
              <div class="fw-semibold text-dark text-truncate mb-1" style="font-size: 0.9rem;"><%= item.name %></div>
              <div class="text-danger fw-bold small"><%= item.price.toLocaleString('vi-VN') %> đ</div>
            </div>
            <a href="/products/<%= item._id %>" class="btn btn-outline-dark btn-sm w-100 mt-2 rounded-2 py-1" style="font-size: 0.8rem;">Xem mẫu</a>
          </div>
        <% }) %>
      <% } else { %>
        <!-- Mockup dự phòng nếu Controller chưa kịp truyền dữ liệu liên quan -->
        <div class="text-muted py-3 ps-2 small">Đang tìm các sản phẩm cùng danh mục tương tự...</div>
      <% } %>
    </div>
  </div>

  <!-- KHUNG TRÒ CHUYỆN / ĐÁNH GIÁ SẢN PHẨM TRỰC TIẾP -->
  <div class="row g-4">
    <!-- Khung form gửi bình luận, đánh giá (Chỉ dành cho Khách hàng) -->
    <div class="col-12 col-lg-4">
      <div class="bg-white p-4 rounded-4 shadow-sm border border-light h-100">
        <h4 class="fw-bold text-dark mb-3" style="font-size: 1.2rem;"><i class="bi bi-chat-heart text-success me-2"></i>Đánh giá sản phẩm</h4>
        
        <% if (typeof user !== 'undefined' && user) { %>
          <form method="POST" action="/products/<%= product._id %>/review">
            <!-- Chọn số sao đánh giá trực quan -->
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Số sao đánh giá của bạn:</label>
              <div class="rating-input text-warning fs-3 d-flex gap-1">
                <input type="radio" name="rating" value="5" id="star5" class="d-none" checked><label for="star5" class="bi bi-star-fill cursor-pointer"></label>
                <input type="radio" name="rating" value="4" id="star4" class="d-none"><label for="star4" class="bi bi-star-fill cursor-pointer"></label>
                <input type="radio" name="rating" value="3" id="star3" class="d-none"><label for="star3" class="bi bi-star-fill cursor-pointer"></label>
                <input type="radio" name="rating" value="2" id="star2" class="d-none"><label for="star2" class="bi bi-star-fill cursor-pointer"></label>
                <input type="radio" name="rating" value="1" id="star1" class="d-none"><label for="star1" class="bi bi-star-fill cursor-pointer"></label>
              </div>
            </div>
            
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Lời nhắn / Nội dung trao đổi:</label>
              <textarea name="comment" rows="4" class="form-control border bg-light rounded-3" placeholder="Nhập câu hỏi, thắc mắc hoặc đánh giá chất lượng sản phẩm..." required></textarea>
            </div>
            <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold rounded-3 shadow-sm">Gửi phản hồi</button>
          </form>
        <% } else { %>
          <div class="text-center py-4 bg-light rounded-3 border border-dashed">
            <p class="text-muted small mb-3">Vui lòng đăng nhập tài khoản của bạn để tham gia phòng chat đánh giá sản phẩm này.</p>
            <a href="/auth/login" class="btn btn-primary btn-sm px-4 rounded-pill fw-semibold">Đăng nhập ngay</a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Luồng hội thoại trực tiếp giữa Khách hàng, Admin và Nhân viên -->
    <div class="col-12 col-lg-8">
      <div class="bg-white p-4 rounded-4 shadow-sm border border-light d-flex flex-column" style="height: 400px;">
        <h4 class="fw-bold text-dark mb-3" style="font-size: 1.2rem;"><i class="bi bi-chat-dots text-info me-2"></i>Phòng trao đổi trực tuyến</h4>
        
        <!-- Khung danh sách tin nhắn cuộn nội bộ giống Messenger -->
        <div class="flex-grow-1 overflow-y-auto pe-1 d-flex flex-column gap-3" style="scroll-behavior: smooth;">
          <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
            <% reviews.forEach(rev => { %>
              <div class="d-flex gap-2 align-items-start">
                <!-- Avatar giả lập dựa trên vai trò -->
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm flex-shrink-0" 
class="align-items-center justify-content-center text-white fw-bold shadow-sm flex-shrink-0 role-avatar-<%= rev.userRole %>"
                  <%= rev.userName ? rev.userName.charAt(0).toUpperCase() : 'U' %>
                </div>
                <!-- Khối nội dung tin nhắn chat -->
                <div class="p-3 rounded-3 position-relative border shadow-sm w-100" style="background-color: #fafafa;">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold text-dark" style="font-size: 0.88rem;">
                      <%= rev.userName %> 
                      <% if(rev.userRole === 'admin') { %><span class="badge bg-danger ms-1" style="font-size:0.65rem;">Quản trị viên</span><% } %>
                      <% if(rev.userRole === 'staff') { %><span class="badge bg-primary ms-1" style="font-size:0.65rem;">Nhân viên</span><% } %>
                    </span>
                    <span class="text-muted" style="font-size: 0.75rem;"><%= new Date(rev.createdAt).toLocaleDateString('vi-VN') %></span>
                  </div>
                  <!-- Hiển thị sao nếu là đánh giá -->
                  <% if(rev.rating > 0) { %>
                    <div class="text-warning mb-1" style="font-size: 0.75rem;">
                      <% for(let s=1; s<=5; s++) { %>
                        <i class="bi bi-star<%= s <= rev.rating ? '-fill' : '' %>"></i>
                      <% } %>
                    </div>
                  <% } %>
                  <p class="text-secondary m-0 small" style="line-height: 1.4;"><%= rev.comment %></p>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center text-muted my-auto py-5">
              <i class="bi bi-chat-left-dots display-6 d-block mb-2 text-black-50"></i>
              <span class="small">Chưa có cuộc trao đổi nào. Hãy là người đầu tiên đặt câu hỏi!</span>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- CSS BỔ SUNG CHO HIỆU ỨNG TRANG CHI TIẾT SẢN PHẨM -->
<style>
  .scrollbar-hidden::-webkit-scrollbar { display: none; }
  .scrollbar-hidden { -ms-overflow-style: none; scrollbar-width: none; }
  .cursor-pointer { cursor: pointer; }
  .transform-hover:hover { transform: scale(1.04); }
  .fw-extrabold { font-weight: 800; }
  
  /* Tạo hiệu ứng hover chọn sao ngược từ phải qua trái chuyên nghiệp */
  .rating-input { display: flex; flex-direction: row-reverse; justify-content: flex-end; }
  .rating-input input:checked ~ label,
  .rating-input label:hover,
  .rating-input label:hover ~ label { color: #ffc107 !important; }
  .rating-input label { color: #e4e4e4; transition: color 0.2s; }
</style>
<%- include('partials/footer') %>
