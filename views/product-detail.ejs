<%- include('partials/header') %>

<div class="container py-4" style="background-color: #f5f5f5; font-family: -apple-system, HelveticaNeue, Helvetica, Roboto, Arial, sans-serif;">
  
  <!-- Nút quay lại & Điều hướng nhanh -->
  <nav aria-label="breadcrumb" class="mb-3">
    <a href="/products" class="btn btn-sm btn-light border-0 bg-white shadow-sm px-3 fw-medium text-secondary" style="font-size: 0.85rem; border-radius: 2px;">
      <i class="bi bi-arrow-left me-1"></i> Quay lại cửa hàng
    </a>
  </nav>

  <div class="bg-white p-3 p-md-4 mb-4" style="border-radius: 3px; box-shadow: 0 1px 1px 0 rgba(0,0,0,.05);">
    <div class="row g-4">
      
      <!-- Vùng trái: Ảnh sản phẩm (Cố định tỷ lệ vuông 1:1 chuẩn thương mại điện tử) -->
      <div class="col-12 col-md-5">
        <div class="d-flex flex-column gap-2">
          <div class="text-center d-flex align-items-center justify-content-center bg-white position-relative" 
               style="aspect-ratio: 1 / 1; width: 100%; border: 1px solid rgba(0,0,0,.05);">
            <img src="<%= product.image %>" alt="<%= product.name %>" class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain;">
          </div>
          <!-- Khu vực Thumbnails chạy ngang sẽ bổ sung tại đây nếu cần -->
        </div>
      </div>
      
      <!-- Vùng phải: Thông tin bán hàng chi tiết -->
      <div class="col-12 col-md-7 d-flex flex-column justify-content-start">
        <div class="ps-md-3">
          
          <!-- Tên sản phẩm: Font chữ đứng, giảm kích thước chuẩn chỉnh, không quá to -->
          <h1 class="fw-medium text-dark mb-2 line-clamp-2" style="font-size: 1.25rem; line-height: 1.4; word-break: break-word; color: #222 !important;">
            <%= product.name %>
          </h1>
          
          <!-- Thanh chỉ số đánh giá ngang chuẩn Shopee -->
          <div class="d-flex flex-wrap align-items-center mb-3 gap-3 shopee-rating-bar" style="font-size: 0.875rem;">
            
            <!-- Điểm Đánh Giá số -->
            <div class="d-flex align-items-center gap-1 border-end pe-3" style="border-color: rgba(0,0,0,.1) !important;">
              <% 
                let avgRating = 0;
                if (typeof reviews !== 'undefined' && reviews.length > 0) {
                  let total = reviews.reduce((sum, r) => sum + r.rating, 0);
                  avgRating = (total / reviews.length).toFixed(1);
                }
                let fullStars = Math.floor(avgRating);
                let hasHalf = avgRating - fullStars >= 0.5;
              %>
              <span class="fw-medium text-danger border-bottom border-danger border-1" style="color: #077416 !important; border-color: #ee4d2d !important;"><%= avgRating > 0 ? avgRating : '0.0' %></span>
              <div class="small ms-1" style="color: #077416;">
                <% for(let i=1; i<=5; i++) { %>
                  <% if(i <= fullStars) { %>
                    <i class="bi bi-star-fill"></i>
                  <% } else if(i === fullStars + 1 && hasHalf) { %>
                    <i class="bi bi-star-half"></i>
                  <% } else { %>
                    <i class="bi bi-star"></i>
                  <% } %>
                <% } %>
              </div>
            </div>
            
            <!-- Số lượng Đánh Giá văn bản -->
            <div class="border-end pe-3 text-dark" style="border-color: rgba(0,0,0,.1) !important;">
              <span class="fw-medium border-bottom border-dark border-1" style="color: #222;"><%= typeof reviews !== 'undefined' ? reviews.length : 0 %></span>
              <span class="text-muted small ms-1">Đánh Giá</span>
            </div>

            <!-- Số lượng Đã Bán -->
            <div class="text-dark">
              <span class="fw-medium" style="color: #222;">0</span>
              <span class="text-muted small ms-1">Đã Bán</span>
            </div>
          </div>

          <!-- Khối hiển thị giá tiền bản rộng đặc trưng với nền xám rất nhạt -->
          <div class="p-3 w-100 d-flex align-items-center mb-4" style="background-color: #fafafa; border-radius: 2px;">
            <span class="fw-medium m-0" style="color: #077416; font-size: 1.875rem;">
              <span class="fw-normal style-currency" style="font-size: 1.25rem; vertical-align: super; margin-right: 2px;">đ</span><%= product.price.toLocaleString('vi-VN') %>
            </span>
          </div>

                    <!-- Vận chuyển chuẩn phong cách Shopee với text thụt lề đều -->
          <div class="d-flex align-items-start gap-3 mb-4 py-1" style="font-size: 0.875rem;">
            <div class="text-secondary" style="width: 110px; min-width: 110px;">Vận Chuyển</div>
            <div class="d-flex flex-column gap-2 text-dark">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-truck" style="color: #00bfa5; font-size: 1.1rem;"></i>
                <span class="fw-medium" style="color: #222;">Miễn phí vận chuyển</span>
              </div>
              <div class="text-muted" style="font-size: 0.8rem; padding-left: 26px;">
                Miễn phí vận chuyển cho đơn hàng từ 50.000 đ
              </div>
            </div>
          </div>
        </div>

        <!-- Khung tương tác đặt hàng tích hợp số lượng và nút bấm song song -->
        <div class="ps-md-3 mt-2">
          <% if (product.stock > 0) { %>
            <form method="POST" action="/cart/add" class="d-flex flex-column gap-4">
              <input type="hidden" name="productId" value="<%= product._id %>">
              
              <!-- Dòng chọn số lượng dẹt phẳng chuẩn UI Shopee -->
              <div class="d-flex align-items-center gap-3" style="font-size: 0.875rem;">
                <div class="text-secondary" style="width: 110px; min-width: 110px;">Số Lượng</div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                  <div class="input-group border d-flex align-items-center bg-white" style="width: 120px; height: 32px; border-color: rgba(0,0,0,.09) !important; border-radius: 2px;">
                    <button type="button" class="btn btn-light bg-transparent border-0 text-secondary px-2 d-flex align-items-center justify-content-center h-100 style-btn-qty" style="font-size: 0.75rem; width: 32px;" onclick="this.parentNode.querySelector('input[type=number]').stepDown()">
                      <i class="bi bi-dash-lg"></i>
                    </button>
                    <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>" class="form-control border-start border-end border-0 text-center bg-transparent fw-normal p-0 text-dark h-100 shadow-none" style="font-size: 0.9rem; border-color: rgba(0,0,0,.09) !important; color: #222 !important;" required>
                    <button type="button" class="btn btn-light bg-transparent border-0 text-secondary px-2 d-flex align-items-center justify-content-center h-100 style-btn-qty" style="font-size: 0.75rem; width: 32px;" onclick="this.parentNode.querySelector('input[type=number]').stepUp()">
                      <i class="bi bi-plus-lg"></i>
                    </button>
                  </div>
                  <span class="text-secondary" style="font-size: 0.875rem;"><%= product.stock %> sản phẩm có sẵn</span>
                </div>
              </div>

              <!-- Cặp nút bấm hành động -->
              <div class="d-flex flex-wrap gap-3 mt-2">
                <button type="submit" class="btn px-4 fw-normal d-flex align-items-center justify-content-center gap-2" 
                        style="height: 48px; min-width: 210px; background-color: rgba(255, 87, 34, 0.1); border: 1px solid #ee4d2d; color: #077416; border-radius: 2px; font-size: 0.95rem;">
                  <i class="bi bi-cart-plus" style="font-size: 1.2rem;"></i> Thêm Vào Giỏ Hàng
                </button>
                <button type="submit" formaction="/cart/buy-now" class="btn btn-danger px-4 fw-normal d-flex align-items-center justify-content-center flex-grow-1 flex-md-grow-0" 
                        style="height: 48px; min-width: 180px; background-color: #077416; border: none; border-radius: 2px; font-size: 0.95rem;">
                  Mua Ngay
                </button>
              </div>

            </form>

          <% } else { %>
            <div class="p-3 bg-light rounded-1 text-muted text-center border-0 mb-2" style="background-color: #fff8f7 !important; color: #ff5722 !important; border: 1px solid #f9dad6 !important; border-radius: 2px;">
              <i class="bi bi-exclamation-triangle-fill me-2"></i>Sản phẩm hiện tại đã hết hàng. Vui lòng quay lại sau!
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

<!-- MÔ TẢ SẢN PHẨM - CO GỌN + SCROLLBOX -->
<div class="product-desc-section" style="background:#fff; border-radius:4px; box-shadow:0 1px 4px rgba(0,0,0,0.08); padding:20px 24px; margin-bottom:12px;">
  <div style="font-size:1rem; font-weight:500; color:#333; text-transform:uppercase; letter-spacing:0.3px; padding-bottom:12px; border-bottom:1px solid #e8e8e8; margin-bottom:12px;">
    Mô Tả Sản Phẩm
  </div>

  <!-- PREVIEW: luôn hiện 3 dòng đầu -->
  <div id="descPreview" style="font-size:0.88rem; color:#555; line-height:1.8; white-space:pre-line; display:block;">
    <%= product.description ? product.description.substring(0, 200) : '' %><% if(product.description && product.description.length > 200) { %>...<% } %>
  </div>

  <div id="descScrollBox" style="display:none; margin-top:10px;">
    <div style="
      max-height: 280px;
      overflow-y: auto;
      border: 1px solid #e8e8e8;
      border-radius: 4px;
      padding: 14px 16px;
      background: #fafafa;
      font-size: 0.88rem;
      color: #444;
      line-height: 1.9;
      white-space: pre-line;
      scroll-behavior: smooth;
    "
    id="descScrollContent">
      <%= product.description %>
    </div>
  </div>

  <!-- NÚT XEM THÊM / THU GỌN — NGOÀI FORM, type=button bắt buộc -->
  <% if(product.description && product.description.length > 200) { %>
  <button type="button" id="descToggleBtn" onclick="toggleDescBox()"
    style="
      display:flex; align-items:center; justify-content:center; gap:6px;
      width:100%; margin-top:10px; padding:7px;
      background:none; border:1px solid #e0e0e0; border-radius:2px;
      color:#ee4d2d; font-size:0.87rem; font-weight:500;
      cursor:pointer; transition:background 0.15s;
    "
    onmouseover="this.style.background='#fff2ee'"
    onmouseout="this.style.background='none'">
    <span id="descBtnLabel">Xem thêm</span>
    <i class="bi bi-chevron-down" id="descBtnIcon"
       style="font-size:0.8rem; transition:transform 0.3s;"></i>
  </button>
  <% } %>
</div>

<script>
function toggleDescBox() {
  var preview  = document.getElementById('descPreview');
  var scrollBox = document.getElementById('descScrollBox');
  var label    = document.getElementById('descBtnLabel');
  var icon     = document.getElementById('descBtnIcon');

  var isOpen = scrollBox.style.display === 'block';

  if (isOpen) {
    // Thu gọn
    scrollBox.style.display = 'none';
    preview.style.display   = 'block';
    label.textContent       = 'Xem thêm';
    icon.style.transform    = 'rotate(0deg)';
  } else {
    // Mở scrollbox, ẩn preview
    scrollBox.style.display = 'block';
    preview.style.display   = 'none';
    label.textContent       = 'Thu gọn';
    icon.style.transform    = 'rotate(180deg)';
    // Scroll về đầu scrollbox
    document.getElementById('descScrollContent').scrollTop = 0;
  }
}

 const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('error') === 'ordered_only') {
    alert('Bạn chỉ có thể gửi bình luận/đánh giá sản phẩm này sau khi đơn hàng chứa sản phẩm đã được giao thành công!');
  }
</script>

  <!-- THANH CUỐN NGANG SẢN PHẨM LIÊN QUAN (Chuẩn Grid/Flex bo mờ Shopee) -->
  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-end mb-3">
      <!-- Tiêu đề in hoa nhẹ, màu xám đậm đặc trưng của mục Gợi ý -->
      <h3 class="fw-medium m-0 text-uppercase" style="font-size: 1rem; color: #888; letter-spacing: 0.5px;">
        <i class="bi bi-grid-3x3-gap-fill me-2" style="color: #ee4d2d;"></i>Sản phẩm liên quan
      </h3>
      <span class="text-secondary small d-md-none">Kéo ngang để xem <i class="bi bi-arrow-right-short"></i></span>
    </div>
    
    <!-- Container cuộn mượt mà trên Mobile và co giãn dạng Grid trên Desktop -->
    <div class="d-flex overflow-x-auto gap-2 pb-2 scrollbar-hidden" style="scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;">
      <% if (typeof relatedProducts !== 'undefined' && relatedProducts.length > 0) { %>
        <% relatedProducts.forEach(item => { %>
          <!-- Thẻ sản phẩm: Viền cực mảnh, đổ bóng nhẹ khi hover, không bo góc tròn sâu -->
          <div class="bg-white p-2 d-flex flex-column justify-content-between flex-shrink-0 style-product-card" 
               style="width: 190px; scroll-snap-align: start; border: 1px solid rgba(0,0,0,.05); border-radius: 2px; transition: transform 0.1s ease, box-shadow 0.1s ease;">
            <a href="/products/<%= item._id %>" class="text-center d-block mb-2 overflow-hidden bg-light position-relative" style="aspect-ratio: 1 / 1; width: 100%;">
              <img src="<%= item.image %>" alt="<%= item.name %>" class="w-100 h-100" style="object-fit: contain;">
            </a>
            <div class="px-1 flex-grow-1 d-flex flex-column justify-content-between">
              <!-- Tên sản phẩm Shopee: Chữ thường, thu gọn 2 dòng -->
              <div class="text-dark mb-2 text-wrap" style="font-size: 0.8rem; line-height: 1.3; height: 2.6rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: #222 !important;">
                <%= item.name %>
              </div>
              <div class="d-flex align-items-center justify-content-between mt-auto pt-1">
                <div class="fw-medium" style="color: #ee4d2d; font-size: 0.95rem;">
                  <span style="font-size: 0.75rem; vertical-align: super;">đ</span><%= item.price.toLocaleString('vi-VN') %>
                </div>
                <span class="text-muted" style="font-size: 0.7rem;">Đã bán 0</span>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-secondary py-3 ps-2" style="font-size: 0.85rem;">Đang tìm các sản phẩm cùng danh mục tương tự...</div>
      <% } %>
    </div>
  </div>

  <!-- Thêm một đoạn CSS bổ sung để tối ưu trải nghiệm cuộn và hiệu ứng hover -->
  <style>
    .scrollbar-hidden::-webkit-scrollbar { display: none; }
    .scrollbar-hidden { -ms-overflow-style: none; scrollbar-width: none; }
    .style-btn-qty:hover { background-color: rgba(0,0,0,.02) !important; }
    .style-product-card:hover {
      transform: translateY(-1px);
      box-shadow: 0 2px 12px rgba(0,0,0,.1);
      border-color: #ee4d2d !important;
    }

    body {
  overflow-x: hidden !important;
}

  </style>


  <!-- KHUNG TRÒ CHUYỆN / ĐÁNH GIÁ SẢN PHẨM TRỰC TIẾP -->
  <div class="row g-4">
    <!-- Khung form gửi bình luận, đánh giá (Chỉ dành cho Khách hàng) -->
    <div class="col-12 col-lg-4">
      <div class="bg-white p-4 rounded-4 shadow-sm border border-light h-100">
        <h4 class="fw-bold text-dark mb-3" style="font-size: 1.2rem;"><i class="bi bi-chat-heart text-success me-2"></i>Đánh giá sản phẩm</h4>
        
        <% if (typeof user !== 'undefined' && user) { %>
          <form method="POST" action="/products/<%= product._id %>/review">
            <!-- Chọn số sao đánh giá trực quan -->
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Số sao đánh giá của bạn:</label>
              <div class="rating-input text-warning fs-3 d-flex gap-1">
                <input type="radio" name="rating" value="5" id="star5" class="d-none" checked><label for="star5" class="bi bi-star-fill cursor-pointer"></label>
                <input type="radio" name="rating" value="4" id="star4" class="d-none"><label for="star4" class="bi bi-star-fill cursor-pointer"></label>
                <input type="radio" name="rating" value="3" id="star3" class="d-none"><label for="star3" class="bi bi-star-fill cursor-pointer"></label>
                <input type="radio" name="rating" value="2" id="star2" class="d-none"><label for="star2" class="bi bi-star-fill cursor-pointer"></label>
                <input type="radio" name="rating" value="1" id="star1" class="d-none"><label for="star1" class="bi bi-star-fill cursor-pointer"></label>
              </div>
            </div>
            
            <div class="mb-3">
              <label class="form-label small fw-bold text-secondary">Lời nhắn / Nội dung trao đổi:</label>
              <textarea name="comment" rows="4" class="form-control border bg-light rounded-3" placeholder="Nhập câu hỏi, thắc mắc hoặc đánh giá chất lượng sản phẩm..." required></textarea>
            </div>
            <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold rounded-3 shadow-sm">Gửi phản hồi</button>
          </form>
        <% } else { %>
          <div class="text-center py-4 bg-light rounded-3 border border-dashed">
            <p class="text-muted small mb-3">Vui lòng đăng nhập tài khoản của bạn để tham gia phòng chat đánh giá sản phẩm này.</p>
            <a href="/auth/login" class="btn btn-primary btn-sm px-4 rounded-pill fw-semibold">Đăng nhập ngay</a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Luồng hội thoại trực tiếp giữa Khách hàng, Admin và Nhân viên -->
    <div class="col-12 col-lg-8">
      <div class="bg-white p-4 rounded-4 shadow-sm border border-light d-flex flex-column" style="height: 400px;">
        <h4 class="fw-bold text-dark mb-3" style="font-size: 1.2rem;"><i class="bi bi-chat-dots text-info me-2"></i>Phòng trao đổi trực tuyến</h4>
        
        <div class="flex-grow-1 overflow-y-auto pe-1 d-flex flex-column gap-3" style="scroll-behavior: smooth;">
          <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
            <% reviews.forEach(rev => { %>
              <div class="d-flex gap-2 align-items-start">
                <!-- Avatar giả lập dựa trên vai trò -->
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm flex-shrink-0 role-avatar-<%= rev.userRole %>"
                  style="width:36px;height:36px;font-size:.85rem;background-color:#077416;">
                  <%= rev.userName ? rev.userName.charAt(0).toUpperCase() : 'U' %>
                </div>
                <!-- Khối nội dung tin nhắn chat -->
                <div class="p-3 rounded-3 position-relative border shadow-sm w-100" style="background-color: #fafafa;">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold text-dark" style="font-size: 0.88rem;">
                      <%= rev.userName %> 
                      <% if(rev.userRole === 'admin') { %><span class="badge bg-danger ms-1" style="font-size:0.65rem;">Quản trị viên</span><% } %>
                      <% if(rev.userRole === 'staff') { %><span class="badge bg-primary ms-1" style="font-size:0.65rem;">Nhân viên</span><% } %>
                    </span>
                    <span class="text-muted" style="font-size: 0.75rem;"><%= new Date(rev.createdAt).toLocaleDateString('vi-VN') %></span>
                  </div>
                  <% if(rev.rating > 0) { %>
                    <div class="text-warning mb-1" style="font-size: 0.75rem;">
                      <% for(let s=1; s<=5; s++) { %>
                        <i class="bi bi-star<%= s <= rev.rating ? '-fill' : '' %>"></i>
                      <% } %>
                    </div>
                  <% } %>
                  <p class="text-secondary m-0 small" style="line-height: 1.4;"><%= rev.comment %></p>
                  <!-- PHẦN REPLY CỦA ADMIN/STAFF -->
                  <% if (rev.reply) { %>
                    <div class="mt-2 pt-2 border-top border-success-subtle">
                      <div class="d-flex gap-2 align-items-start">
                        <div class="rounded-circle bg-success d-flex align-items-center justify-content-center text-white fw-bold flex-shrink-0" style="width:28px;height:28px;font-size:.75rem;">
                          <%= rev.replyBy ? rev.replyBy.charAt(0).toUpperCase() : 'A' %>
                        </div>
                        <div class="flex-grow-1">
                          <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-success" style="font-size:.82rem;">
                              <%= rev.replyBy %>
                              <span class="badge bg-success ms-1" style="font-size:.6rem;">Phản hồi</span>
                            </span>
                            <span class="text-muted" style="font-size:.72rem;">
                              <%= rev.replyAt ? new Date(rev.replyAt).toLocaleDateString('vi-VN') : '' %>
                            </span>
                          </div>
                          <p class="text-dark m-0 small mt-1" style="line-height:1.4"><%= rev.reply %></p>
                          <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'staff')) { %>
                            <form method="POST" action="/products/<%= product._id %>/review/<%= rev._id %>/delete-reply" class="d-inline mt-1">
                              <button class="btn btn-link text-danger p-0" style="font-size:.75rem;" onclick="return confirm('Xóa phản hồi này?')">
                                <i class="bi bi-trash"></i> Xóa phản hồi
                              </button>
                            </form>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  <% } %>

                  <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'staff') && !rev.reply) { %>
                    <div class="mt-2 pt-2 border-top">
                      <form method="POST" action="/products/<%= product._id %>/review/<%= rev._id %>/reply" class="d-flex gap-2">
                        <input type="text" name="reply" class="form-control form-control-sm rounded-pill" placeholder="Nhập phản hồi..." required style="font-size:.85rem;">
                        <button type="submit" class="btn btn-success btn-sm rounded-pill px-3" style="font-size:.82rem;white-space:nowrap;">
                          <i class="bi bi-reply"></i> Gửi
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center text-muted my-auto py-5">
              <i class="bi bi-chat-left-dots display-6 d-block mb-2 text-black-50"></i>
              <span class="small">Chưa có cuộc trao đổi nào. Hãy là người đầu tiên đặt câu hỏi!</span>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

</div>

