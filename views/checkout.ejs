<%- include('partials/header') %>
<div class="container-fluid px-4 py-5">
  <h2 class="section-title mb-4"><i class="bi bi-credit-card"></i> Thanh toán đơn hàng</h2>
  
  <div class="row g-4">
    <!-- Cột trái: Form nhập thông tin trải rộng -->
    <div class="col-xl-8 col-lg-7">
      <div class="bg-white rounded-3 shadow-sm p-4">
        <h5 class="fw-bold mb-4 border-bottom pb-2 text-primary">Thông tin giao hàng & Thanh toán</h5>
        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        
        <form method="POST" action="/orders/checkout">
          <div class="row g-4">
            <!-- Hàng 1: Họ tên và Số điện thoại -->
            <div class="col-md-6">
              <label class="form-label fw-600">Họ tên người nhận <span class="text-danger">*</span></label>
              <input type="text" name="fullName" class="form-control form-control-lg" placeholder="Nhập họ và tên..." required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-600">Số điện thoại <span class="text-danger">*</span></label>
              <input type="text" name="phone" class="form-control form-control-lg" placeholder="Nhập số điện thoại di động..." required>
            </div>
            
            <!-- Hàng 2: Địa chỉ cascade 3 cấp -->
<div class="col-12">
  <label class="form-label fw-600">Địa chỉ giao hàng <span class="text-danger">*</span></label>
  <input type="text" name="address" class="form-control form-control-lg"
    placeholder="Số nhà, ngõ ngách, tên đường..." required>
</div>

<!-- 3 dropdown cascade -->
<div class="col-md-4">
  <label class="form-label fw-600">Tỉnh / Thành phố <span class="text-danger">*</span></label>
  <select id="sel-province" name="province" class="form-select form-select-lg" required>
    <option value="">-- Chọn Tỉnh / Thành phố --</option>
  </select>
</div>
<div class="col-md-4">
  <label class="form-label fw-600">Quận / Huyện <span class="text-danger">*</span></label>
  <select id="sel-district" name="district" class="form-select form-select-lg" required disabled>
    <option value="">-- Chọn Quận / Huyện --</option>
  </select>
</div>
<div class="col-md-4">
  <label class="form-label fw-600">Phường / Xã <span class="text-danger">*</span></label>
  <select id="sel-ward" name="ward" class="form-select form-select-lg" required disabled>
    <option value="">-- Chọn Phường / Xã --</option>
  </select>
</div>

<!-- Hidden field ghép địa chỉ đầy đủ gửi lên server -->
<input type="hidden" name="city" id="full-address-city">

<!-- Script cascade địa chính -->
<script>
(function () {
  const BASE = 'https://provinces.open-api.vn/api';
  const selP = document.getElementById('sel-province');
  const selD = document.getElementById('sel-district');
  const selW = document.getElementById('sel-ward');
  const hidCity = document.getElementById('full-address-city');

  /* Loading spinner option */
  function loadingOpt() {
    return '<option value="">Đang tải...</option>';
  }

  /* 1. Load tỉnh/thành khi trang mở */
  fetch(`${BASE}/?depth=1`)
    .then(r => r.json())
    .then(data => {
      data.sort((a, b) => a.name.localeCompare(b.name, 'vi'));
      data.forEach(p => {
        selP.insertAdjacentHTML('beforeend',
          `<option value="${p.code}" data-name="${p.name}">${p.name}</option>`);
      });
    })
    .catch(() => {
      selP.insertAdjacentHTML('beforeend',
        '<option disabled>Không tải được dữ liệu</option>');
    });

  /* 2. Khi chọn tỉnh → load huyện */
  selP.addEventListener('change', function () {
    const code = this.value;
    const name = this.options[this.selectedIndex]?.dataset.name || '';

    // Reset huyện và xã
    selD.innerHTML = loadingOpt();
    selD.disabled = true;
    selW.innerHTML = '<option value="">-- Chọn Phường / Xã --</option>';
    selW.disabled = true;
    hidCity.value = '';

    if (!code) return;

    fetch(`${BASE}/p/${code}?depth=2`)
      .then(r => r.json())
      .then(data => {
        selD.innerHTML = '<option value="">-- Chọn Quận / Huyện --</option>';
        data.districts
          .sort((a, b) => a.name.localeCompare(b.name, 'vi'))
          .forEach(d => {
            selD.insertAdjacentHTML('beforeend',
              `<option value="${d.code}" data-name="${d.name}">${d.name}</option>`);
          });
        selD.disabled = false;
        hidCity.value = name; // Tạm lưu tỉnh
      });
  });

  /* 3. Khi chọn huyện → load xã */
  selD.addEventListener('change', function () {
    const code = this.value;
    const dName = this.options[this.selectedIndex]?.dataset.name || '';
    const pName = selP.options[selP.selectedIndex]?.dataset.name || '';

    selW.innerHTML = loadingOpt();
    selW.disabled = true;
    hidCity.value = `${dName}, ${pName}`;

    if (!code) return;

    fetch(`${BASE}/d/${code}?depth=2`)
      .then(r => r.json())
      .then(data => {
        selW.innerHTML = '<option value="">-- Chọn Phường / Xã --</option>';
        data.wards
          .sort((a, b) => a.name.localeCompare(b.name, 'vi'))
          .forEach(w => {
            selW.insertAdjacentHTML('beforeend',
              `<option value="${w.code}" data-name="${w.name}">${w.name}</option>`);
          });
        selW.disabled = false;
      });
  });

  /* 4. Khi chọn xã → cập nhật hidden field đầy đủ */
  selW.addEventListener('change', function () {
    const wName = this.options[this.selectedIndex]?.dataset.name || '';
    const dName = selD.options[selD.selectedIndex]?.dataset.name || '';
    const pName = selP.options[selP.selectedIndex]?.dataset.name || '';
    hidCity.value = `${wName}, ${dName}, ${pName}`;
  });
})();
</script>
            <!-- Hàng 3: Phương thức thanh toán và Ghi chú -->
            <div class="col-md-5">
              <label class="form-label fw-600">Phương thức thanh toán <span class="text-danger">*</span></label>
              <select name="paymentMethod" class="form-select">
                <option value="cod">💵 Thanh toán khi nhận hàng (COD)</option>
              </select>
            </div>
            <div class="col-md-7">
              <label class="form-label fw-600">Ghi chú giao hàng</label>
              <textarea name="note" class="form-control" rows="2" placeholder="Ghi chú thêm cho shipper hoặc cửa hàng (nếu có)..."></textarea>
            </div>
            
            <!-- Nút submit kéo dài vừa vặn hàng -->
            <div class="col-12 mt-4">
              <button type="submit" class="btn btn-success w-100 py-3 fs-5 shadow-sm">
                <i class="bi bi-shield-check me-2"></i> Xác nhận và Đặt hàng ngay
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
    
    <!-- Cột phải: Tóm tắt đơn hàng bên cạnh -->
    <div class="col-xl-4 col-lg-5">
      <div class="bg-white rounded-3 shadow-sm p-4 sticky-top" style="top: 20px;">
        <h5 class="fw-bold mb-3 border-bottom pb-2">Đơn hàng của bạn</h5>
        <div class="cart-items-review mb-3" style="max-height: 400px; overflow-y: auto;">
          <% cart.forEach(item => { %>
          <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-3">
              <img src="<%= item.image %>" width="56" height="56" style="object-fit:contain;border-radius:8px;background:#f8f9fa;padding:4px">
              <div>
                <div class="fw-600 small text-wrap" style="max-width: 180px;"><%= item.name %></div>
                <small class="text-muted">Số lượng: x<%= item.quantity %></small>
              </div>
            </div>
            <div class="fw-bold text-dark"><%= (item.price * item.quantity).toLocaleString('vi-VN') %> đ</div>
          </div>
          <% }) %>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
          <span class="fw-bold fs-5">Tổng cộng:</span>
          <span class="cart-total text-danger fw-bold fs-4"><%= total.toLocaleString('vi-VN') %> đ</span>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
