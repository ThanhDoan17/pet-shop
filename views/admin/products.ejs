<%- include('../partials/header') %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0"><i class="bi bi-box-seam"></i> Quản lý sản phẩm</h2>
  </div>

  <div class="mb-3">
    <a href="/admin" class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-speedometer2"></i> Dashboard</a>
    <a href="/admin/orders" class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-bag"></i> Đơn hàng</a>
    <a href="/admin/statistics" class="btn btn-outline-secondary btn-sm"><i class="bi bi-bar-chart"></i> Thống kê</a>
  </div>

  <form method="GET" action="/admin/products" class="mb-3">
  <div class="input-group" style="max-width:400px">
    <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" class="form-control" placeholder="🔍 Tìm sản phẩm...">
    <button class="btn btn-primary">Tìm</button>
    <% if (typeof search !== 'undefined' && search) { %><a href="/admin/products" class="btn btn-outline-secondary">Xóa</a><% } %>
  </div>
</form>

  <div class="bg-white rounded-3 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>Ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Danh mục</th>
            <th>Tồn kho</th>
            <th class="text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
          <tr>
            <td><img src="<%= p.image %>" width="60" height="60" style="object-fit:contain;" class="rounded"></td>
            <td>
              <div class="fw-600"><%= p.name %></div>
              <small class="text-muted"><%= p.description ? p.description.substring(0,50) + '...' : '' %></small>
            </td>
            <td class="fw-bold text-warning"><%= p.price.toLocaleString('vi-VN') %> đ</td>
            <td>
              <span class="badge bg-secondary">
                <%= p.category === 'tank' ? '🏘️ Bể & Lồng' : p.category === 'food' ? '🌿 Thức ăn' : p.category === 'accessory' ? '🎯 Phụ kiện' : p.category === 'reptile' ? '🦎 Bò sát' : p.category === 'hamster' ? '🐹 Hamster' : p.category === 'medicine' ? '💊 Thuốc' : p.category === 'clothing' ? '👗 Quần áo' : '🐠 Cá' %>
              </span>
            </td>
            <td>
              <span class="badge <%= p.stock > 10 ? 'bg-success' : p.stock > 0 ? 'bg-warning text-dark' : 'bg-danger' %>">
                <%= p.stock %> sản phẩm
              </span>
            </td>
            <td class="text-center">
              <a href="/admin/products/edit/<%= p._id %>" class="btn btn-sm btn-outline-primary me-1">
                <i class="bi bi-pencil"></i> Sửa
              </a>
              <form method="POST" action="/admin/products/delete/<%= p._id %>" style="display:inline">
                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa sản phẩm này?')">
                  <i class="bi bi-trash"></i> Xóa
                </button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>