<%- include('../layouts/dashboard', { 
    title: 'Trang Tổng Quan',
    pageTitle: 'Trang tổng quan',
    currentPage: 'dashboard',
    user: user,
    body: `
        <div class="dashboard-content-inner p-4">
            <h2 class="mb-4"><i class="bi bi-speedometer2 me-2"></i> Trang tổng quan</h2>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 text-center p-5 shadow-sm">
                        <i class="bi bi-box-seam fs-1 text-primary mb-3"></i>
                        <h3 class="fw-bold text-primary">${totalProducts || 0}</h3>
                        <p class="text-muted">Tổng sản phẩm</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 text-center p-5 shadow-sm">
                        <i class="bi bi-bag-check fs-1 text-success mb-3"></i>
                        <h3 class="fw-bold text-success">${totalOrders || 0}</h3>
                        <p class="text-muted">Tổng đơn hàng</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 text-center p-5 shadow-sm">
                        <i class="bi bi-clock-history fs-1 text-warning mb-3"></i>
                        <h3 class="fw-bold text-warning">${pendingOrders || 0}</h3>
                        <p class="text-muted">Đơn chờ xử lý</p>
                    </div>
                </div>
            </div>
        </div>
    `
}) %>