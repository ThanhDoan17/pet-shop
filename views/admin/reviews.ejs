<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Phản hồi đánh giá - PESTshop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body class="dashboard-body">
<div class="dashboard-wrapper">

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand"><i class="bi bi-water"></i><span>PEST<strong>shop</strong></span></div>
    <div class="sidebar-user">
      <div class="sidebar-avatar"><%= user ? user.name.charAt(0).toUpperCase() : 'A' %></div>
      <div>
        <div class="sidebar-username">Chào, <%= user ? user.name : '' %></div>
        <div class="sidebar-role"><span class="role-badge role-admin">Admin</span></div>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/admin" class="nav-item" title="Trang chủ"><i class="bi bi-speedometer2"></i><span>Trang chủ</span></a>
      <a href="/admin/products" class="nav-item" title="Sản phẩm"><i class="bi bi-box-seam"></i><span>Sản phẩm</span></a>
      <a href="/admin/orders" class="nav-item" title="Đơn hàng"><i class="bi bi-bag-check"></i><span>Đơn hàng</span></a>
      <a href="/admin/users" class="nav-item" title="Người dùng"><i class="bi bi-people"></i><span>Người dùng</span></a>
      <a href="/admin/reviews" class="nav-item active" title="Phản hồi"><i class="bi bi-chat-square-text"></i><span>Phản hồi</span></a>
      <a href="/admin/statistics" class="nav-item" title="Thống kê"><i class="bi bi-bar-chart-line"></i><span>Thống kê</span></a>
      <div class="sidebar-divider"></div>
      <a href="/auth/logout" class="nav-item nav-item--logout"><i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span></a>
    </nav>
  </aside>

  <div class="dashboard-main">
    <header class="dashboard-header">
      <div class="header-left">
        <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
        <div class="header-title"><h1>Phản hồi đánh giá</h1><p>Trả lời bình luận của khách hàng</p></div>
      </div>
      <div class="header-right">
        <span class="header-time" id="header-time"></span>
      </div>
    </header>

    <main class="dashboard-content">
      <form method="GET" action="/admin/reviews" class="d-flex gap-2 mb-4">
        <input type="text" name="search" value="<%= search %>" class="form-control form-control-sm" style="width:320px" placeholder="🔍 Tìm theo nội dung bình luận...">
        <button class="dash-btn dash-btn--primary dash-btn--sm">Tìm</button>
        <% if (search) { %><a href="/admin/reviews" class="dash-btn dash-btn--outline dash-btn--sm">Xóa</a><% } %>
      </form>

      <% if (reviews.length === 0) { %>
        <div class="dash-card text-center py-5">
          <div class="fs-1">💬</div>
          <h4 class="text-muted mt-3">Chưa có đánh giá nào</h4>
        </div>
      <% } else { %>
        <div class="d-flex flex-column gap-3">
          <% reviews.forEach(r => { %>
          <div class="dash-card" style="padding:20px">

            <!-- Header: thông tin sản phẩm -->
            <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
              <% if (r.productId) { %>
                <img src="<%= r.productId.image %>" width="44" height="44" style="object-fit:contain;border-radius:8px;background:#f8f9fa;padding:3px">
                <div>
                  <div class="fw-bold" style="font-size:.88rem"><%= r.productId.name %></div>
                  <a href="/products/<%= r.productId._id %>" target="_blank" class="text-muted" style="font-size:.75rem">Xem sản phẩm →</a>
                </div>
              <% } else { %>
                <span class="text-muted small">Sản phẩm đã bị xóa</span>
              <% } %>
              <span class="ms-auto text-muted" style="font-size:.75rem"><%= new Date(r.createdAt).toLocaleDateString('vi-VN') %></span>
            </div>

            <!-- Nội dung bình luận -->
            <div class="d-flex gap-3 mb-3">
              <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold flex-shrink-0" style="width:36px;height:36px;font-size:.82rem">
                <%= r.userName ? r.userName.charAt(0).toUpperCase() : 'U' %>
              </div>
              <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                  <span class="fw-bold" style="font-size:.88rem"><%= r.userName %></span>
                  <% if (r.userRole==='admin') { %><span class="dash-badge dash-badge--red" style="font-size:.65rem">Admin</span><% } %>
                  <% if (r.userRole==='staff') { %><span class="dash-badge dash-badge--blue" style="font-size:.65rem">Nhân viên</span><% } %>
                  <% if (r.rating > 0) { %>
                    <div class="text-warning" style="font-size:.78rem">
                      <% for(let s=1;s<=5;s++){%><i class="bi bi-star<%= s<=r.rating?'-fill':'' %>"></i><%}%>
                    </div>
                  <% } %>
                </div>
                <p class="text-secondary mb-0" style="font-size:.88rem;line-height:1.5"><%= r.comment %></p>
              </div>
            </div>

            <!-- Phản hồi hiện tại -->
            <% if (r.reply) { %>
              <div class="ms-5 mb-3 p-3 rounded-3 border border-success-subtle" style="background:#f0fff4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="fw-bold text-success" style="font-size:.82rem">
                    <i class="bi bi-reply-fill me-1"></i><%= r.replyBy %>
                    <span class="dash-badge dash-badge--green ms-1" style="font-size:.6rem">Đã phản hồi</span>
                  </span>
                  <span class="text-muted" style="font-size:.72rem"><%= r.replyAt ? new Date(r.replyAt).toLocaleDateString('vi-VN') : '' %></span>
                </div>
                <p class="text-dark mb-2" style="font-size:.86rem;line-height:1.5"><%= r.reply %></p>
                <form method="POST" action="/admin/reviews/<%= r._id %>/delete-reply" class="d-inline">
                  <button class="dash-btn dash-btn--danger dash-btn--sm" onclick="return confirm('Xóa phản hồi này?')">
                    <i class="bi bi-trash"></i> Xóa
                  </button>
                </form>
              </div>
            <% } %>

            <!-- Form phản hồi -->
            <div class="ms-5">
              <form method="POST" action="/admin/reviews/<%= r._id %>/reply" class="d-flex gap-2">
                <input type="text" name="reply" class="form-control form-control-sm rounded-pill"
                  placeholder="<%= r.reply ? 'Cập nhật phản hồi...' : 'Nhập phản hồi...' %>"
                  value="<%= r.reply || '' %>" required>
                <button type="submit" class="dash-btn dash-btn--primary dash-btn--sm" style="border-radius:50px;white-space:nowrap">
                  <i class="bi bi-reply"></i> <%= r.reply ? 'Cập nhật' : 'Gửi' %>
                </button>
              </form>
            </div>

          </div>
          <% }) %>
        </div>
      <% } %>
    </main>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function toggleSidebar() { document.getElementById('sidebar').classList.toggle('collapsed'); }
function updateTime() {
  const el = document.getElementById('header-time');
  if (el) el.textContent = new Date().toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
}
setInterval(updateTime,1000); updateTime();
</script>
</body>
</html>