<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - PESTshop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body class="dashboard-body">
<div class="dashboard-wrapper">

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand"><i class="bi bi-water"></i><span>PEST<strong>shop</strong></span></div>
    <div class="sidebar-user">
      <div class="sidebar-avatar"><%= user ? user.name.charAt(0).toUpperCase() : 'A' %></div>
      <div>
        <div class="sidebar-username">Chào, <%= user ? user.name : '' %></div>
        <div class="sidebar-role">
          <% if (user && user.role === 'admin') { %>
            <span class="role-badge role-admin">Admin</span>
          <% } else { %>
            <span class="role-badge role-staff">Nhân viên</span>
          <% } %>
        </div>
      </div>
    </div>
    <nav class="sidebar-nav">
      <% if (user && user.role === 'admin') { %>
        <a href="/admin" class="nav-item" title="Trang chủ"><i class="bi bi-speedometer2"></i><span>Trang chủ</span></a>
        <a href="/admin/products" class="nav-item active" title="Sản phẩm"><i class="bi bi-box-seam"></i><span>Sản phẩm</span></a>
        <a href="/admin/orders" class="nav-item" title="Đơn hàng"><i class="bi bi-bag-check"></i><span>Đơn hàng</span></a>
        <a href="/admin/users" class="nav-item" title="Người dùng"><i class="bi bi-people"></i><span>Người dùng</span></a>
        <a href="/admin/reviews" class="nav-item" title="Phản hồi"><i class="bi bi-chat-square-text"></i><span>Phản hồi</span></a>
        <a href="/admin/statistics" class="nav-item" title="Thống kê"><i class="bi bi-bar-chart-line"></i><span>Thống kê</span></a>
      <% } else { %>
        <a href="/staff/inventory" class="nav-item" title="Tồn kho"><i class="bi bi-boxes"></i><span>Tồn kho</span></a>
        <a href="/staff/orders" class="nav-item" title="Đơn hàng"><i class="bi bi-bag-check"></i><span>Đơn hàng</span></a>
        <a href="/staff/products/add" class="nav-item active" title="Thêm sản phẩm"><i class="bi bi-plus-circle"></i><span>Thêm sản phẩm</span></a>
      <% } %>
      <div class="sidebar-divider"></div>
      <a href="/auth/logout" class="nav-item nav-item--logout"><i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span></a>
    </nav>
  </aside>

  <div class="dashboard-main">
    <header class="dashboard-header">
      <div class="header-left">
        <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
        <div class="header-title">
          <h1><%= product ? 'Sửa sản phẩm' : 'Thêm sản phẩm mới' %></h1>
          <p><%= product ? 'Cập nhật thông tin sản phẩm' : 'Điền đầy đủ thông tin sản phẩm mới' %></p>
        </div>
      </div>
      <div class="header-right">
        <span class="header-time" id="header-time"></span>
        <a href="javascript:history.back()" class="btn-header" title="Quay lại"><i class="bi bi-arrow-left"></i></a>
      </div>
    </header>

    <main class="dashboard-content">
      <div class="dash-card">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div>
        <% } %>

        <form method="POST" action="<%= formAction %>" enctype="multipart/form-data">
          <div class="row g-4">

            <div class="col-xl-4 col-md-6">
              <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" value="<%= product ? product.name : '' %>" placeholder="Nhập tên sản phẩm..." required>
            </div>

            <div class="col-xl-3 col-md-6">
              <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
              <select name="category" class="form-select" required>
                <option value="tank"      <%= product && product.category==='tank'      ? 'selected':'' %>>🏘️ Bể & Lồng nuôi</option>
                <option value="food"      <%= product && product.category==='food'      ? 'selected':'' %>>🌿 Thức ăn</option>
                <option value="accessory" <%= product && product.category==='accessory' ? 'selected':'' %>>🎯 Phụ kiện</option>
                <option value="reptile"   <%= product && product.category==='reptile'   ? 'selected':'' %>>🦎 Bò sát cảnh</option>
                <option value="hamster"   <%= product && product.category==='hamster'   ? 'selected':'' %>>🐹 Chuột Hamster</option>
                <option value="medicine"  <%= product && product.category==='medicine'  ? 'selected':'' %>>💊 Thuốc & Vitamin</option>
                <option value="clothing"  <%= product && product.category==='clothing'  ? 'selected':'' %>>👗 Quần áo thú cưng</option>
                <option value="fish"      <%= product && product.category==='fish'      ? 'selected':'' %>>🐠 Cá cảnh</option>
              </select>
            </div>

            <div class="col-xl-3 col-md-6">
              <label class="form-label fw-bold">Giá (VNĐ) <span class="text-danger">*</span></label>
              <div class="input-group">
                <input type="number" name="price" class="form-control" value="<%= product ? product.price : '' %>" min="0" required>
                <span class="input-group-text">đ</span>
              </div>
            </div>

            <div class="col-xl-2 col-md-6">
              <label class="form-label fw-bold">Tồn kho <span class="text-danger">*</span></label>
              <div class="input-group">
                <input type="number" name="stock" class="form-control" value="<%= product ? product.stock : 0 %>" min="0" required>
                <span class="input-group-text">sp</span>
              </div>
            </div>

            <div class="col-lg-7">
              <label class="form-label fw-bold">Mô tả sản phẩm</label>
              <textarea name="description" class="form-control" rows="6" placeholder="Nhập mô tả chi tiết..."><%= product ? product.description : '' %></textarea>
            </div>

            <div class="col-lg-5">
              <label class="form-label fw-bold">Ảnh sản phẩm</label>
              <div class="p-3 rounded-3 border" style="background:#f8f9fa">
                <% if (product && product.image && product.image !== '/images/default.jpg') { %>
                  <div class="d-flex align-items-center gap-3 mb-3 p-2 bg-white rounded-2 border">
                    <img src="<%= product.image %>" width="72" height="72" style="object-fit:contain;border-radius:8px;padding:4px">
                    <div>
                      <span class="dash-badge dash-badge--gray mb-1 d-inline-block">Ảnh hiện tại</span>
                      <div class="small text-muted text-truncate" style="max-width:180px"><%= product.image %></div>
                    </div>
                  </div>
                <% } %>
                <input type="file" name="image" class="form-control" accept="image/*">
                <small class="text-muted mt-2 d-block">Để trống nếu không muốn thay đổi ảnh.</small>
              </div>
            </div>

            <div class="col-12 text-end pt-2">
              <a href="javascript:history.back()" class="dash-btn dash-btn--outline me-2">
                <i class="bi bi-x-circle"></i> Hủy
              </a>
              <button type="submit" class="dash-btn dash-btn--primary" style="padding:10px 32px">
                <i class="bi bi-<%= product ? 'check-circle' : 'plus-circle' %>"></i>
                <%= product ? ' Lưu thay đổi' : ' Thêm sản phẩm' %>
              </button>
            </div>

          </div>
        </form>
      </div>
    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function toggleSidebar() { document.getElementById('sidebar').classList.toggle('collapsed'); }
function updateTime() {
  const el = document.getElementById('header-time');
  if (el) el.textContent = new Date().toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
}
setInterval(updateTime,1000); updateTime();
</script>
</body>
</html>