<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thống kê - PESTshop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/dashboard.css" rel="stylesheet">
  <style>
  .stat-chart-card {
    background: #fff; border-radius: var(--radius); box-shadow: var(--shadow);
    padding: 24px; margin-bottom: 20px;
    opacity: 0; transform: translateY(24px);
    transition: opacity .6s ease, transform .6s ease;
  }
  .stat-chart-card.visible { opacity: 1; transform: none; }
  .stat-chart-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,.13); transform: translateY(-2px); }
  .stat-chart-card.visible:hover { transform: translateY(-3px); }
  .kpi-stat {
    background: #fff; border-radius: var(--radius); padding: 20px 16px;
    box-shadow: var(--shadow); text-align: center;
    opacity: 0; transform: translateY(20px);
    transition: opacity .5s ease, transform .5s ease, box-shadow .25s;
    border-top: 4px solid var(--primary);
  }
  .kpi-stat.visible { opacity:1; transform:none; }
  .kpi-stat:hover { box-shadow: 0 6px 24px rgba(0,0,0,.13); transform: translateY(-3px) !important; }
  .kpi-stat:nth-child(2){border-top-color:var(--accent)}
  .kpi-stat:nth-child(3){border-top-color:#3498db}
  .kpi-stat:nth-child(4){border-top-color:var(--red)}
  .kpi-stat:nth-child(5){border-top-color:#9b59b6}
  .kpi-stat:nth-child(6){border-top-color:#1abc9c}
  .kpi-stat:nth-child(7){border-top-color:#f39c12}
  .kpi-val { font-size:1.6rem; font-weight:800; color:var(--dark); }
  .kpi-lbl { font-size:.78rem; color:var(--gray-4); margin-top:4px; }
  .chart-title { font-size:.95rem; font-weight:700; color:var(--dark); margin-bottom:16px; display:flex; align-items:center; gap:8px; }
  .chart-title i { color: var(--primary); }
  </style>
</head>
<body class="dashboard-body">
<div class="dashboard-wrapper">

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand"><i class="bi bi-water"></i><span>PEST<strong>shop</strong></span></div>
    <div class="sidebar-user">
      <div class="sidebar-avatar"><%= user ? user.name.charAt(0).toUpperCase() : 'A' %></div>
      <div>
        <div class="sidebar-username">Chào, <%= user ? user.name : '' %></div>
        <div class="sidebar-role"><span class="role-badge role-admin">Admin</span></div>
      </div>
    </div>
    <nav class="sidebar-nav">
      <a href="/admin" class="nav-item" title="Trang chủ"><i class="bi bi-speedometer2"></i><span>Trang chủ</span></a>
      <a href="/admin/products" class="nav-item" title="Sản phẩm"><i class="bi bi-box-seam"></i><span>Sản phẩm</span></a>
      <a href="/admin/orders" class="nav-item" title="Đơn hàng"><i class="bi bi-bag-check"></i><span>Đơn hàng</span></a>
      <a href="/admin/users" class="nav-item" title="Người dùng"><i class="bi bi-people"></i><span>Người dùng</span></a>
      <a href="/admin/reviews" class="nav-item" title="Phản hồi"><i class="bi bi-chat-square-text"></i><span>Phản hồi</span></a>
      <a href="/admin/statistics" class="nav-item active" title="Thống kê"><i class="bi bi-bar-chart-line"></i><span>Thống kê</span></a>
      <div class="sidebar-divider"></div>
      <a href="/auth/logout" class="nav-item nav-item--logout"><i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span></a>
    </nav>
  </aside>

  <div class="dashboard-main">
    <header class="dashboard-header">
      <div class="header-left">
        <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
        <div class="header-title"><h1>Thống kê & Báo cáo</h1><p>Doanh thu và hiệu suất kinh doanh</p></div>
      </div>
      <div class="header-right">
        <span class="header-time" id="header-time"></span>
      </div>
    </header>

    <main class="dashboard-content">

      <!-- KPI CARDS -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3 col-xl-2">
          <div class="kpi-stat">
            <div class="kpi-val"><%= totalProducts %></div>
            <div class="kpi-lbl">📦 Tổng sản phẩm</div>
          </div>
        </div>
        <div class="col-6 col-md-3 col-xl-2">
          <div class="kpi-stat">
            <div class="kpi-val" style="font-size:1.1rem"><%= totalValue.toLocaleString('vi-VN') %>đ</div>
            <div class="kpi-lbl">💰 Giá trị kho</div>
          </div>
        </div>
        <div class="col-6 col-md-3 col-xl-2">
          <div class="kpi-stat">
            <div class="kpi-val"><%= totalOrders %></div>
            <div class="kpi-lbl">🛒 Tổng đơn hàng</div>
          </div>
        </div>
        <div class="col-6 col-md-3 col-xl-2">
          <div class="kpi-stat">
            <div class="kpi-val" style="font-size:1.1rem"><%= revenue.toLocaleString('vi-VN') %>đ</div>
            <div class="kpi-lbl">📈 Doanh thu</div>
          </div>
        </div>
        <div class="col-6 col-md-3 col-xl-2">
          <div class="kpi-stat">
            <div class="kpi-val" style="font-size:1.1rem"><%= maxPrice.toLocaleString('vi-VN') %>đ</div>
            <div class="kpi-lbl">⬆️ Giá cao nhất</div>
          </div>
        </div>
        <div class="col-6 col-md-3 col-xl-2">
          <div class="kpi-stat">
            <div class="kpi-val" style="font-size:1.1rem"><%= avgPrice.toLocaleString('vi-VN') %>đ</div>
            <div class="kpi-lbl">📊 Giá trung bình</div>
          </div>
        </div>
      </div>

      <!-- FILTER FORM -->
      <div class="dash-card mb-4" style="padding:16px 20px">
        <form method="GET" action="/admin/statistics" class="d-flex gap-3 align-items-end flex-wrap">
          <div>
            <label class="form-label fw-bold mb-1" style="font-size:.8rem">Loại thống kê</label>
            <select name="type" class="form-select form-select-sm" style="width:200px">
              <option value="day"   <%= type==='day'   ?'selected':'' %>>Theo ngày (trong tháng)</option>
              <option value="month" <%= type==='month' ?'selected':'' %>>Theo tháng (trong năm)</option>
              <option value="year"  <%= type==='year'  ?'selected':'' %>>Theo năm</option>
            </select>
          </div>
          <% if (type !== 'year') { %>
          <div>
            <label class="form-label fw-bold mb-1" style="font-size:.8rem">Năm</label>
            <input type="number" name="year" value="<%= year %>" class="form-control form-control-sm" style="width:100px" min="2020" max="2030">
          </div>
          <% } %>
          <% if (type === 'day') { %>
          <div>
            <label class="form-label fw-bold mb-1" style="font-size:.8rem">Tháng</label>
            <input type="number" name="month" value="<%= month %>" class="form-control form-control-sm" style="width:80px" min="1" max="12">
          </div>
          <% } %>
          <button class="dash-btn dash-btn--primary dash-btn--sm">Xem</button>
        </form>
      </div>

      <!-- CHARTS ROW 1 -->
      <div class="row g-4 mb-2">
        <div class="col-lg-8">
          <div class="stat-chart-card">
            <div class="chart-title"><i class="bi bi-bar-chart-fill"></i> Doanh thu theo <%= type==='day'?'ngày':type==='month'?'tháng':'năm' %></div>
            <canvas id="chartBar" height="220"></canvas>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="stat-chart-card">
            <div class="chart-title"><i class="bi bi-pie-chart-fill"></i> Cơ cấu doanh thu</div>
            <canvas id="chartPie" height="220"></canvas>
          </div>
        </div>
      </div>

      <!-- CHARTS ROW 2 -->
      <div class="row g-4 mb-2">
        <div class="col-lg-6">
          <div class="stat-chart-card">
            <div class="chart-title"><i class="bi bi-graph-up-arrow"></i> Top 5 sản phẩm bán chạy</div>
            <canvas id="chartTop" height="220"></canvas>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="stat-chart-card">
            <div class="chart-title"><i class="bi bi-diagram-3-fill"></i> Flowchart trạng thái đơn hàng</div>
            <canvas id="chartFlow" height="220"></canvas>
          </div>
        </div>
      </div>

      <!-- TABLE -->
      <div class="stat-chart-card">
        <div class="chart-title"><i class="bi bi-table"></i> Bảng chi tiết doanh thu</div>
        <% if (orderStats.length === 0) { %>
          <p class="text-muted text-center py-4">Chưa có dữ liệu cho khoảng thời gian này</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="dash-table">
              <thead>
                <tr>
                  <th><%= labelFormat %></th>
                  <th>Số đơn</th>
                  <th>Doanh thu</th>
                </tr>
              </thead>
              <tbody>
                <% orderStats.forEach(s => { %>
                <tr>
                  <td><%= labelFormat %> <%= s._id %></td>
                  <td><span class="dash-badge dash-badge--blue"><%= s.count %> đơn</span></td>
                  <td class="fw-bold" style="color:var(--accent)"><%= s.total.toLocaleString('vi-VN') %> đ</td>
                </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr style="background:#f8f9fa">
                  <td><strong>Tổng cộng</strong></td>
                  <td><strong><%= orderStats.reduce((s,i)=>s+i.count,0) %> đơn</strong></td>
                  <td><strong style="color:var(--primary)"><%= orderStats.reduce((s,i)=>s+i.total,0).toLocaleString('vi-VN') %> đ</strong></td>
                </tr>
              </tfoot>
            </table>
          </div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
function toggleSidebar() { document.getElementById('sidebar').classList.toggle('collapsed'); }
function updateTime() {
  const el = document.getElementById('header-time');
  if (el) el.textContent = new Date().toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
}
setInterval(updateTime,1000); updateTime();

// Scroll reveal
const obs = new IntersectionObserver(entries => {
  entries.forEach((e,i) => {
    if (e.isIntersecting) {
      setTimeout(() => e.target.classList.add('visible'), i * 80);
    }
  });
}, { threshold: 0.08 });
document.querySelectorAll('.stat-chart-card, .kpi-stat').forEach((el,i) => {
  el.style.transitionDelay = (i * 0.07) + 's';
  obs.observe(el);
});

Chart.defaults.font.family = "'Be Vietnam Pro','Segoe UI',sans-serif";
Chart.defaults.color = '#6c757d';
const COLORS = ['#2ecc71','#3498db','#e67e22','#e74c3c','#9b59b6','#1abc9c','#f39c12','#34495e'];

const orderStats = <%- JSON.stringify(orderStats) %>;
const topProducts = <%- JSON.stringify(topProducts) %>;

// BAR CHART
new Chart(document.getElementById('chartBar'), {
  type: 'bar',
  data: {
    labels: orderStats.map(s => '<%= labelFormat %> ' + s._id),
    datasets: [{
      label: 'Doanh thu (đ)',
      data: orderStats.map(s => s.total),
      backgroundColor: COLORS[0] + 'cc',
      borderColor: COLORS[0],
      borderWidth: 2,
      borderRadius: 8,
    },{
      label: 'Số đơn',
      data: orderStats.map(s => s.count),
      type: 'line',
      borderColor: COLORS[2],
      backgroundColor: COLORS[2] + '22',
      borderWidth: 2,
      pointRadius: 4,
      tension: 0.4,
      yAxisID: 'y1'
    }]
  },
  options: {
    responsive: true,
    animation: { duration: 900, easing: 'easeOutQuart' },
    interaction: { mode: 'index', intersect: false },
    plugins: { legend: { position: 'top' }, tooltip: { callbacks: { label: ctx => ctx.datasetIndex===0 ? ' '+ctx.raw.toLocaleString('vi-VN')+' đ' : ' '+ctx.raw+' đơn' } } },
    scales: {
      y: { ticks: { callback: v => (v/1000000).toFixed(0)+'M' }, grid: { color: '#f0f0f0' } },
      y1: { type: 'linear', position: 'right', grid: { drawOnChartArea: false }, ticks: { stepSize: 1 } }
    }
  }
});

// PIE CHART
new Chart(document.getElementById('chartPie'), {
  type: 'doughnut',
  data: {
    labels: orderStats.length ? orderStats.map(s => '<%= labelFormat %> '+s._id) : ['Chưa có dữ liệu'],
    datasets: [{ data: orderStats.length ? orderStats.map(s=>s.total) : [1], backgroundColor: COLORS, borderWidth: 2, borderColor:'#fff', hoverOffset: 10 }]
  },
  options: {
    responsive: true,
    cutout: '58%',
    animation: { duration: 1000, easing: 'easeOutBounce' },
    plugins: { legend: { position:'bottom', labels:{padding:10,font:{size:11}} }, tooltip: { callbacks: { label: ctx => ' '+ctx.raw.toLocaleString('vi-VN')+' đ' } } }
  }
});

// TOP PRODUCTS HORIZONTAL BAR
new Chart(document.getElementById('chartTop'), {
  type: 'bar',
  data: {
    labels: topProducts.map(p => p._id ? p._id.substring(0,25) : 'Không rõ'),
    datasets: [{
      label: 'Doanh thu',
      data: topProducts.map(p => p.totalRevenue),
      backgroundColor: COLORS.map(c => c+'cc'),
      borderColor: COLORS,
      borderWidth: 2,
      borderRadius: 6
    }]
  },
  options: {
    indexAxis: 'y',
    responsive: true,
    animation: { duration: 900 },
    plugins: { legend:{display:false}, tooltip:{ callbacks:{ label: ctx => ' '+ctx.raw.toLocaleString('vi-VN')+' đ' } } },
    scales: { x: { ticks: { callback: v => (v/1000000).toFixed(1)+'M' }, grid:{color:'#f0f0f0'} } }
  }
});

// FLOWCHART - trạng thái đơn hàng dạng doughnut
const statusData = <%- JSON.stringify(statusStats || []) %>;
const statusLabels = { pending:'Chờ xử lý', confirmed:'Đã xác nhận', shipping:'Đang giao', delivered:'Đã giao', cancelled:'Đã hủy' };
const statusColors = { pending:'#f39c12', confirmed:'#3498db', shipping:'#1abc9c', delivered:'#2ecc71', cancelled:'#e74c3c' };

new Chart(document.getElementById('chartFlow'), {
  type: 'doughnut',
  data: {
    labels: statusData.map(s => statusLabels[s._id] || s._id),
    datasets: [{
      data: statusData.map(s => s.count),
      backgroundColor: statusData.map(s => statusColors[s._id] || '#adb5bd'),
      borderWidth: 3,
      borderColor: '#fff',
      hoverOffset: 12
    }]
  },
  options: {
    responsive: true,
    cutout: '50%',
    animation: { duration: 1100, easing: 'easeOutElastic' },
    plugins: {
      legend: { position:'right', labels:{padding:14,font:{size:12}} },
      tooltip: { callbacks: { label: ctx => ' '+ctx.raw+' đơn' } }
    }
  }
});
</script>
</body>
</html>